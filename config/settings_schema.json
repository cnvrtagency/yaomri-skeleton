        "max": 34,
        "step": 1,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "icon_button_size_desktop",
        "label": "Desktop icon button size",
        "info": "Clickable button size around each header icon. The minimum protects usability; use icon spacing to change the gap between buttons.",
        "min": 36,
        "max": 64,
        "step": 2,
        "unit": "px",
        "default": 44
      },
      {
        "type": "range",
        "id": "icon_button_size_mobile",
        "label": "Mobile icon button size",
        "info": "Clickable tap target around each mobile icon. The minimum protects touch usability; very small spacing can feel crowded.",
        "min": 34,
        "max": 56,
        "step": 2,
        "unit": "px",
        "default": 42
      },
      {
        "type": "range",
        "id": "desktop_icon_gap",
        "label": "Desktop icon spacing",
        "info": "Gap between desktop icon buttons. Button size controls the clickable area; spacing controls the space between buttons.",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "mobile_icon_gap",
        "label": "Mobile icon spacing",
        "info": "Gap between mobile icon buttons. Keep this modest so icons do not crowd the logo or drawer button.",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 0
