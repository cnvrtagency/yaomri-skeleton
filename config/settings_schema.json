          },
          {
            "value": "subtle",
            "label": "Subtle"
          },
          {
            "value": "medium",
            "label": "Medium"
          },
          {
            "value": "strong",
            "label": "Strong"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ]
      },
