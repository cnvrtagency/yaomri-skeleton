[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "mobile_logo",
        "label": "Mobile logo"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "site_content_width",
        "label": "Site content width",
        "min": 1000,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "range",
        "id": "site_side_padding",
        "label": "Side padding",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#1a1a1a",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "sand_color",
        "default": "#f6f4ef",
        "label": "Sand"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#737373",
        "label": "Muted text"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#e8e8e8",
        "label": "Border"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 0
      }
    ]
  }
]
