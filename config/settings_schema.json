[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "mobile_logo",
        "label": "Mobile logo"
      },
      {
        "type": "range",
        "id": "desktop_logo_width",
        "label": "Desktop logo width",
        "min": 60,
        "max": 320,
        "step": 5,
        "unit": "px",
        "default": 130
      },
      {
        "type": "range",
        "id": "mobile_logo_width",
        "label": "Mobile logo width",
        "min": 50,
        "max": 220,
        "step": 5,
        "unit": "px",
        "default": 120
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "site_width_mode",
        "label": "Site width mode",
        "default": "boxed",
        "options": [
          {
            "value": "boxed",
            "label": "Boxed"
          },
          {
            "value": "full",
            "label": "Full width"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ]
      },
      {
        "type": "range",
        "id": "custom_site_content_width",
        "label": "Custom site width",
        "info": "Only applies when Site width mode is set to Custom.",
        "min": 1000,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "default": 1200
      }
    ]
  },
  {
    "name": "Header",
