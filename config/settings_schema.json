      },
      {
        "type": "color",
        "id": "country_selector_border",
        "label": "Country selector border"
      },
      {
        "type": "color",
        "id": "country_selector_text",
        "label": "Country selector text colour"
      },
      {
        "type": "range",
        "id": "country_selector_height",
