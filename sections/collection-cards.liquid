{{ 'section-collection-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-collection-cards.js' | asset_url }}" defer></script>

{%- liquid
  assign layout_mode = section.settings.layout_mode | default: 'carousel'
  assign section_width_mode = section.settings.section_width | default: 'full'
  assign custom_section_width = section.settings.custom_section_width | default: 1500
  assign card_ratio = section.settings.card_image_ratio | default: '4-5'
  assign show_arrows = section.settings.show_arrows
  assign show_count_default = section.settings.show_count_default

  assign section_width_value = 'none'
  if section_width_mode == 'site'
    assign section_width_value = 'var(--page-width)'
  elsif section_width_mode == 'custom'
    capture section_width_value
      echo custom_section_width
      echo 'px'
    endcapture
  endif

  assign ratio_value = '4 / 5'
  case card_ratio
    when '1-1'
      assign ratio_value = '1 / 1'
    when '4-3'
      assign ratio_value = '4 / 3'
    when '16-9'
      assign ratio_value = '16 / 9'
  endcase
-%}

<section
  class="cc-carousel cc-carousel--layout-{{ layout_mode }} cc-carousel--ratio-{{ card_ratio }}{% if section.settings.border_top %} cc-carousel--border-top{% endif %}"
  aria-label="{{ section.settings.heading | default: 'Collection cards' | escape }}"
  style="
    --cc-max-width: {{ section_width_value }};
    --cc-bg: {{ section.settings.background_color }};
    --cc-border-color: {{ section.settings.border_color }};
    --cc-gap-desktop: {{ section.settings.gap_desktop }}px;
    --cc-gap-mobile: {{ section.settings.gap_mobile }}px;
    --cc-image-ratio: {{ ratio_value }};
    --cc-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --cc-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --cc-padding-left-desktop: {{ section.settings.padding_left_desktop }}px;
    --cc-padding-right-desktop: {{ section.settings.padding_right_desktop }}px;
    --cc-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --cc-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --cc-padding-left-mobile: {{ section.settings.padding_left_mobile }}px;
    --cc-padding-right-mobile: {{ section.settings.padding_right_mobile }}px;
    --cc-margin-top-desktop: {{ section.settings.margin_top_desktop }}px;
    --cc-margin-bottom-desktop: {{ section.settings.margin_bottom_desktop }}px;
    --cc-margin-top-mobile: {{ section.settings.margin_top_mobile }}px;
    --cc-margin-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="cc-carousel__inner">
    <div class="cc-carousel__head">
      <h2 class="cc-carousel__title">
        {{ section.settings.heading }}
        {%- if section.settings.heading_subtitle != blank -%}
          <span class="cc-carousel__subtitle">{{ section.settings.heading_subtitle }}</span>
        {%- endif -%}
      </h2>
      {%- if layout_mode == 'carousel' and show_arrows -%}
        <div class="cc-carousel__nav">
          <button type="button" class="cc-carousel__btn" data-cc-prev aria-label="Previous collection cards">
            {% render 'icon-yaomri-chevron-left' %}
          </button>
          <button type="button" class="cc-carousel__btn" data-cc-next aria-label="Next collection cards">
            {% render 'icon-yaomri-chevron-right' %}
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- assign valid_cards = 0 -%}
    {%- for block in section.blocks -%}
      {%- assign coll = collections[block.settings.collection] -%}
      {%- assign card_title_check = block.settings.title | default: coll.title -%}
      {%- if card_title_check != blank or block.settings.image != blank or coll.image != blank -%}
        {%- assign valid_cards = valid_cards | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if valid_cards == 0 -%}
      {%- if request.design_mode -%}
        <div class="cc-carousel__track cc-carousel__track--grid">
          {%- for i in (1..4) -%}
            <article class="cc-card cc-card--placeholder">
              <div class="cc-card__media"><div class="cc-card__placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div></div>
              <div class="cc-card__overlay"><p class="cc-card__title">Collection</p></div>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div
        class="cc-carousel__track{% if layout_mode == 'grid' %} cc-carousel__track--grid{% endif %}"
        data-cc-track
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign coll = collections[block.settings.collection]
            assign card_img = block.settings.image | default: coll.image
            assign card_title = block.settings.title | default: coll.title
            assign card_subtitle = block.settings.subtitle
            assign card_link = block.settings.link_override | default: coll.url
            assign show_count = block.settings.show_count
            if show_count == blank
              assign show_count = show_count_default
            endif
          -%}
          {%- if card_title != blank or card_img != blank -%}
            {%- if card_link != blank -%}
              <a
                href="{{ card_link }}"
                class="cc-card cc-card--hover-{{ section.settings.image_hover }}"
                {{ block.shopify_attributes }}
                {% if block.settings.open_new_window %}target="_blank" rel="noopener noreferrer"{% endif %}
                aria-label="{{ card_title | escape }}"
              >
                <div class="cc-card__media">
                  {%- if card_img != blank -%}
                    {{
                      card_img
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '300,500,700,900',
                        sizes: '(min-width:1024px) 24vw, (min-width:768px) 32vw, (min-width:640px) 45vw, 70vw',
                        class: 'cc-card__img',
                        alt: card_title | default: card_img.alt | escape
                    }}
                  {%- else -%}
                    <div class="cc-card__placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
                  {%- endif -%}
                  <div class="cc-card__overlay">
                    {%- if card_title != blank -%}
                      <p class="cc-card__title">{{ card_title }}</p>
                    {%- endif -%}
                    {%- if show_count and coll.products_count > 0 -%}
                      <p class="cc-card__count">{{ coll.products_count }} pieces</p>
                    {%- elsif card_subtitle != blank -%}
                      <p class="cc-card__count">{{ card_subtitle }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </a>
            {%- else -%}
              <article class="cc-card cc-card--hover-{{ section.settings.image_hover }}" {{ block.shopify_attributes }}>
                <div class="cc-card__media">
                  {%- if card_img != blank -%}
                    {{
                      card_img
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '300,500,700,900',
                        sizes: '(min-width:1024px) 24vw, (min-width:768px) 32vw, (min-width:640px) 45vw, 70vw',
                        class: 'cc-card__img',
                        alt: card_title | default: card_img.alt | escape
                    }}
                  {%- else -%}
                    <div class="cc-card__placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
                  {%- endif -%}
                  <div class="cc-card__overlay">
                    {%- if card_title != blank -%}
                      <p class="cc-card__title">{{ card_title }}</p>
                    {%- endif -%}
                    {%- if show_count and coll.products_count > 0 -%}
                      <p class="cc-card__count">{{ coll.products_count }} pieces</p>
                    {%- elsif card_subtitle != blank -%}
                      <p class="cc-card__count">{{ card_subtitle }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection cards",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by collection" },
    { "type": "text", "id": "heading_subtitle", "label": "Heading subtitle", "default": "Curated edits" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout",
      "default": "carousel",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full",
      "options": [
        { "value": "site", "label": "Site width" },
        { "value": "full", "label": "Full width" },
        { "value": "custom", "label": "Custom width" }
      ]
    },
    { "type": "range", "id": "custom_section_width", "label": "Custom section width", "min": 720, "max": 2200, "step": 20, "unit": "px", "default": 1500 },
    { "type": "color", "id": "background_color", "label": "Background colour", "default": "#ffffff" },
    { "type": "checkbox", "id": "border_top", "label": "Border top", "default": true },
    { "type": "color", "id": "border_color", "label": "Border colour", "default": "#e8e8e8" },
    {
      "type": "select",
      "id": "card_image_ratio",
      "label": "Card image ratio",
      "default": "4-5",
      "options": [
        { "value": "4-5", "label": "Portrait 4:5" },
        { "value": "1-1", "label": "Square 1:1" },
        { "value": "4-3", "label": "Landscape 4:3" },
        { "value": "16-9", "label": "Wide 16:9" }
      ]
    },
    {
      "type": "select",
      "id": "image_hover",
      "label": "Image hover",
      "default": "subtle_zoom",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "subtle_zoom", "label": "Subtle zoom" }
      ]
    },
    { "type": "range", "id": "gap_desktop", "label": "Gap desktop", "min": 8, "max": 40, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "gap_mobile", "label": "Gap mobile", "min": 8, "max": 28, "step": 1, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "show_count_default", "label": "Show product count by default", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top_desktop", "label": "Padding top desktop", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Padding bottom desktop", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left_desktop", "label": "Padding left desktop", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right_desktop", "label": "Padding right desktop", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left_mobile", "label": "Padding left mobile", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right_mobile", "label": "Padding right mobile", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_top_desktop", "label": "Margin top desktop", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom_desktop", "label": "Margin bottom desktop", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_top_mobile", "label": "Margin top mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom_mobile", "label": "Margin bottom mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Card title override" },
        { "type": "text", "id": "subtitle", "label": "Subtitle override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
        { "type": "url", "id": "link_override", "label": "Link override" },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "default": "center center",
          "options": [
            { "value": "center center", "label": "Centre" },
            { "value": "center top", "label": "Top" },
            { "value": "center bottom", "label": "Bottom" },
            { "value": "left center", "label": "Left" },
            { "value": "right center", "label": "Right" }
          ]
        },
        { "type": "checkbox", "id": "open_new_window", "label": "Open in new tab", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection cards",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
