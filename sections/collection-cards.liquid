{{ 'section-collection-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-collection-cards.js' | asset_url }}" defer></script>

{%- liquid
  assign layout_mode = section.settings.layout_mode | default: 'carousel'
  assign section_width_mode = section.settings.section_width | default: 'full'
  if section_width_mode contains 'site'
    assign section_width_mode = 'site'
  elsif section_width_mode contains 'custom'
    assign section_width_mode = 'custom'
  elsif section_width_mode contains 'full'
    assign section_width_mode = 'full'
  endif
  unless section_width_mode == 'site' or section_width_mode == 'full' or section_width_mode == 'custom'
    assign section_width_mode = 'full'
  endunless
  assign custom_section_width = section.settings.custom_section_width | default: 1500
  assign card_ratio = section.settings.card_image_ratio | default: '4-5'
  assign show_arrows = section.settings.show_arrows
  assign show_count_default = section.settings.show_count_default
  assign use_first_product_image = section.settings.use_first_product_image

  assign section_width_value = '100%'
  if section_width_mode == 'site'
    assign section_width_value = 'var(--page-width)'
  elsif section_width_mode == 'custom'
    capture section_width_value
      echo custom_section_width
      echo 'px'
    endcapture
  endif

  assign ratio_value = '4 / 5'
  case card_ratio
    when '1-1'
      assign ratio_value = '1 / 1'
    when '4-3'
      assign ratio_value = '4 / 3'
  when '16-9'
    assign ratio_value = '16 / 9'
  endcase

  assign hover_variant = section.settings.image_hover | replace: '_', '-'
-%}

<section
  class="cnvrt-collection-cards full-width cnvrt-collection-cards--layout-{{ layout_mode }} cnvrt-collection-cards--width-{{ section_width_mode }} cnvrt-collection-cards--ratio-{{ card_ratio }}{% if section.settings.border_top %} cnvrt-collection-cards--border-top{% endif %}"
  aria-label="{{ section.settings.heading | default: 'Collection cards' | escape }}"
  style="
    --cnvrt-collection-cards-container-width: {{ section_width_value }};
    --cnvrt-collection-container-width: var(--cnvrt-collection-cards-container-width, {{ section_width_value }});
    --cnvrt-collection-cards-custom-width: {{ custom_section_width }}px;
    --cnvrt-collection-custom-width: var(--cnvrt-collection-cards-custom-width, {{ custom_section_width }}px);
    --cnvrt-collection-cards-bg: {{ section.settings.background_color }};
    --cnvrt-collection-bg: var(--cnvrt-collection-cards-bg, {{ section.settings.background_color }});
    --cnvrt-collection-cards-border-color: {{ section.settings.border_color }};
    --cnvrt-collection-border-color: var(--cnvrt-collection-cards-border-color, {{ section.settings.border_color }});
    --cnvrt-collection-cards-gap-desktop: {{ section.settings.gap_desktop }}px;
    --cnvrt-collection-gap-desktop: var(--cnvrt-collection-cards-gap-desktop, {{ section.settings.gap_desktop }}px);
    --cnvrt-collection-cards-gap-mobile: {{ section.settings.gap_mobile }}px;
    --cnvrt-collection-gap-mobile: var(--cnvrt-collection-cards-gap-mobile, {{ section.settings.gap_mobile }}px);
    --cnvrt-collection-cards-visible-desktop: {{ section.settings.carousel_cards_desktop | default: '4' }};
    --cnvrt-collection-cards-desktop: var(--cnvrt-collection-cards-visible-desktop, {{ section.settings.carousel_cards_desktop | default: '4' }});
    --cnvrt-collection-cards-visible-tablet: {{ section.settings.carousel_cards_tablet | default: '3' }};
    --cnvrt-collection-cards-tablet: var(--cnvrt-collection-cards-visible-tablet, {{ section.settings.carousel_cards_tablet | default: '3' }});
    --cnvrt-collection-cards-visible-mobile: {{ section.settings.carousel_cards_mobile | default: '1.2' }};
    --cnvrt-collection-cards-mobile: var(--cnvrt-collection-cards-visible-mobile, {{ section.settings.carousel_cards_mobile | default: '1.2' }});
    --cnvrt-collection-cards-image-ratio: {{ ratio_value }};
    --cnvrt-collection-image-ratio: var(--cnvrt-collection-cards-image-ratio, {{ ratio_value }});
    --cnvrt-collection-card-title-size-desktop: {{ section.settings.card_title_size_desktop }}px;
    --cnvrt-collection-title-size-desktop: var(--cnvrt-collection-card-title-size-desktop, {{ section.settings.card_title_size_desktop }}px);
    --cnvrt-collection-card-title-size-mobile: {{ section.settings.card_title_size_mobile }}px;
    --cnvrt-collection-title-size-mobile: var(--cnvrt-collection-card-title-size-mobile, {{ section.settings.card_title_size_mobile }}px);
    --cnvrt-collection-card-title-weight: {{ section.settings.card_title_weight }};
    --cnvrt-collection-title-weight: var(--cnvrt-collection-card-title-weight, {{ section.settings.card_title_weight }});
    --cnvrt-collection-card-title-line-height: {{ section.settings.card_title_line_height | divided_by: 100.0 }};
    --cnvrt-collection-title-line-height: var(--cnvrt-collection-card-title-line-height, {{ section.settings.card_title_line_height | divided_by: 100.0 }});
    --cnvrt-collection-card-title-letter-spacing: {{ section.settings.card_title_letter_spacing | divided_by: 100.0 }}em;
    --cnvrt-collection-title-letter-spacing: var(--cnvrt-collection-card-title-letter-spacing, {{ section.settings.card_title_letter_spacing | divided_by: 100.0 }}em);
    --cnvrt-collection-card-title-transform: {{ section.settings.card_title_transform }};
    --cnvrt-collection-title-transform: var(--cnvrt-collection-card-title-transform, {{ section.settings.card_title_transform }});
    --cnvrt-collection-card-title-color: {{ section.settings.card_title_color }};
    --cnvrt-collection-title-color: var(--cnvrt-collection-card-title-color, {{ section.settings.card_title_color }});
    --cnvrt-collection-card-meta-size-desktop: {{ section.settings.card_meta_size_desktop }}px;
    --cnvrt-collection-meta-size-desktop: var(--cnvrt-collection-card-meta-size-desktop, {{ section.settings.card_meta_size_desktop }}px);
    --cnvrt-collection-card-meta-size-mobile: {{ section.settings.card_meta_size_mobile }}px;
    --cnvrt-collection-meta-size-mobile: var(--cnvrt-collection-card-meta-size-mobile, {{ section.settings.card_meta_size_mobile }}px);
    --cnvrt-collection-card-meta-weight: {{ section.settings.card_meta_weight }};
    --cnvrt-collection-meta-weight: var(--cnvrt-collection-card-meta-weight, {{ section.settings.card_meta_weight }});
    --cnvrt-collection-card-meta-line-height: {{ section.settings.card_meta_line_height | divided_by: 100.0 }};
    --cnvrt-collection-meta-line-height: var(--cnvrt-collection-card-meta-line-height, {{ section.settings.card_meta_line_height | divided_by: 100.0 }});
    --cnvrt-collection-card-meta-letter-spacing: {{ section.settings.card_meta_letter_spacing | divided_by: 100.0 }}em;
    --cnvrt-collection-meta-letter-spacing: var(--cnvrt-collection-card-meta-letter-spacing, {{ section.settings.card_meta_letter_spacing | divided_by: 100.0 }}em);
    --cnvrt-collection-card-meta-transform: {{ section.settings.card_meta_transform }};
    --cnvrt-collection-meta-transform: var(--cnvrt-collection-card-meta-transform, {{ section.settings.card_meta_transform }});
    --cnvrt-collection-card-meta-color: {{ section.settings.card_meta_color }};
    --cnvrt-collection-meta-color: var(--cnvrt-collection-card-meta-color, {{ section.settings.card_meta_color }});
    --cnvrt-collection-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --cnvrt-collection-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --cnvrt-collection-padding-left-desktop: {{ section.settings.padding_left_desktop }}px;
    --cnvrt-collection-padding-right-desktop: {{ section.settings.padding_right_desktop }}px;
    --cnvrt-collection-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --cnvrt-collection-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --cnvrt-collection-padding-left-mobile: {{ section.settings.padding_left_mobile }}px;
    --cnvrt-collection-padding-right-mobile: {{ section.settings.padding_right_mobile }}px;
    --cnvrt-collection-margin-top-desktop: {{ section.settings.margin_top_desktop }}px;
    --cnvrt-collection-margin-bottom-desktop: {{ section.settings.margin_bottom_desktop }}px;
    --cnvrt-collection-margin-top-mobile: {{ section.settings.margin_top_mobile }}px;
    --cnvrt-collection-margin-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="cnvrt-collection-cards__inner">
    <div class="cnvrt-collection-cards__head cnvrt-section-heading cnvrt-section-heading--align-{{ settings.section_heading_alignment | default: 'left' }}">
      <div class="cnvrt-collection-cards__heading-group cnvrt-section-heading__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cnvrt-collection-cards__eyebrow cnvrt-section-heading__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cnvrt-collection-cards__title cnvrt-section-heading__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    </div>
    {%- assign valid_cards = 0 -%}
    {%- for block in section.blocks -%}
      {%- assign coll = collections[block.settings.collection] -%}
      {%- assign fallback_product_image = blank -%}
      {%- if use_first_product_image and coll != blank and coll.products_count > 0 and coll.products.first.featured_image != blank -%}
        {%- assign fallback_product_image = coll.products.first.featured_image -%}
      {%- endif -%}
      {%- assign card_title_check = block.settings.title | default: coll.title -%}
      {%- if card_title_check != blank or block.settings.image != blank or coll.image != blank or fallback_product_image != blank -%}
        {%- assign valid_cards = valid_cards | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if valid_cards > 0 or request.design_mode -%}
      {%- if layout_mode == 'carousel' -%}
        <div class="cnvrt-collection-cards__carousel{% if show_arrows %} cnvrt-collection-cards__carousel--arrows{% endif %}">
          {%- if show_arrows -%}
            <button type="button" class="cnvrt-collection-cards__button cnvrt-collection-cards__button--prev" data-cnvrt-prev aria-label="Previous collection cards">
              {% render 'icon-cnvrt-chevron-left' %}
            </button>
          {%- endif -%}
      {%- endif -%}
      <div
        class="cnvrt-collection-cards__track{% if layout_mode == 'grid' %} cnvrt-collection-cards__track--grid{% endif %}"
        data-cnvrt-track
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign coll = collections[block.settings.collection]
            assign fallback_product_image = blank
            if use_first_product_image and coll != blank and coll.products_count > 0 and coll.products.first.featured_image != blank
              assign fallback_product_image = coll.products.first.featured_image
            endif
            assign card_img = block.settings.image | default: coll.image | default: fallback_product_image
            assign card_title = block.settings.title | default: coll.title
            assign card_subtitle = block.settings.subtitle
            assign card_link = block.settings.link_override | default: coll.url
            assign show_count = block.settings.show_count
            if show_count == blank
              assign show_count = show_count_default
            endif
            assign has_content = false
            if card_title != blank or card_img != blank
              assign has_content = true
            endif
          -%}
          {%- if has_content -%}
            {%- if card_link != blank and valid_cards > 0 -%}
              <a
                href="{{ card_link }}"
                class="cnvrt-collection-card cnvrt-collection-card--hover-{{ hover_variant }}"
                style="--cnvrt-collection-image-position: {{ block.settings.image_position | default: 'center center' }};"
                {{ block.shopify_attributes }}
                {% if block.settings.open_new_window %}target="_blank" rel="noopener noreferrer"{% endif %}
                aria-label="{{ card_title | escape }}"
              >
                <div class="cnvrt-collection-card__media">
                  {%- if block.settings.badge_text != blank -%}
                    <span
                      class="cnvrt-collection-card__badge cnvrt-collection-card__badge--{{ block.settings.badge_placement }}"
                      style="
                        --cnvrt-collection-badge-text: {{ block.settings.badge_text_color }};
                        --cnvrt-collection-badge-bg: {{ block.settings.badge_background_color }};
                        --cnvrt-collection-badge-size: {{ block.settings.badge_font_size }}px;
                        --cnvrt-collection-badge-transform: {{ block.settings.badge_text_transform }};
                      "
                    >
                      {{ block.settings.badge_text }}
                    </span>
                  {%- endif -%}
                  {%- if card_img != blank -%}
                    {{
                      card_img
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '300,500,700,900',
                        sizes: '(min-width:1024px) 24vw, (min-width:768px) 32vw, (min-width:640px) 45vw, 70vw',
                        class: 'cnvrt-collection-card__image',
                        alt: card_title | default: card_img.alt | escape
                    }}
                  {%- else -%}
                    <div class="cnvrt-collection-card__placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
                  {%- endif -%}
                  <div class="cnvrt-collection-card__overlay">
                    {%- if card_title != blank -%}
                      <p class="cnvrt-collection-card__title">{{ card_title }}</p>
                    {%- endif -%}
                    {%- if show_count and coll.products_count > 0 -%}
                      <p class="cnvrt-collection-card__meta">{{ coll.products_count }} pieces</p>
                    {%- elsif card_subtitle != blank -%}
                      <p class="cnvrt-collection-card__meta">{{ card_subtitle }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </a>
            {%- else -%}
              <article
                class="cnvrt-collection-card cnvrt-collection-card--hover-{{ hover_variant }}"
                style="--cnvrt-collection-image-position: {{ block.settings.image_position | default: 'center center' }};"
                {{ block.shopify_attributes }}
              >
                <div class="cnvrt-collection-card__media">
                  {%- if block.settings.badge_text != blank -%}
                    <span
                      class="cnvrt-collection-card__badge cnvrt-collection-card__badge--{{ block.settings.badge_placement }}"
                      style="
                        --cnvrt-collection-badge-text: {{ block.settings.badge_text_color }};
                        --cnvrt-collection-badge-bg: {{ block.settings.badge_background_color }};
                        --cnvrt-collection-badge-size: {{ block.settings.badge_font_size }}px;
                        --cnvrt-collection-badge-transform: {{ block.settings.badge_text_transform }};
                      "
                    >
                      {{ block.settings.badge_text }}
                    </span>
                  {%- endif -%}
                  {%- if card_img != blank -%}
                    {{
                      card_img
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '300,500,700,900',
                        sizes: '(min-width:1024px) 24vw, (min-width:768px) 32vw, (min-width:640px) 45vw, 70vw',
                        class: 'cnvrt-collection-card__image',
                        alt: card_title | default: card_img.alt | escape
                    }}
                  {%- else -%}
                    <div class="cnvrt-collection-card__placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
                  {%- endif -%}
                  <div class="cnvrt-collection-card__overlay">
                    {%- if card_title != blank -%}
                      <p class="cnvrt-collection-card__title">{{ card_title }}</p>
                    {%- endif -%}
                    {%- if show_count and coll.products_count > 0 -%}
                      <p class="cnvrt-collection-card__meta">{{ coll.products_count }} pieces</p>
                    {%- elsif card_subtitle != blank -%}
                      <p class="cnvrt-collection-card__meta">{{ card_subtitle }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endif -%}
          {%- elsif request.design_mode -%}
            <article class="cnvrt-collection-card cnvrt-collection-card--placeholder" {{ block.shopify_attributes }}>
              <div class="cnvrt-collection-card__media">
                <div class="cnvrt-collection-card__placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
              </div>
              <div class="cnvrt-collection-card__overlay">
                <p class="cnvrt-collection-card__title">Collection</p>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
        {%- if request.design_mode and valid_cards == 0 and section.blocks.size == 0 -%}
          {%- for i in (1..4) -%}
            <article class="cnvrt-collection-card cnvrt-collection-card--placeholder">
              <div class="cnvrt-collection-card__media">
                <div class="cnvrt-collection-card__placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
              </div>
              <div class="cnvrt-collection-card__overlay">
                <p class="cnvrt-collection-card__title">Collection</p>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if layout_mode == 'carousel' -%}
        {%- if show_arrows -%}
          <button type="button" class="cnvrt-collection-cards__button cnvrt-collection-cards__button--next" data-cnvrt-next aria-label="Next collection cards">
            {% render 'icon-cnvrt-chevron-right' %}
          </button>
        {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection cards",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by collection" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout",
      "default": "carousel",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full",
      "options": [
        { "value": "site", "label": "Site width" },
        { "value": "full", "label": "Full width" },
        { "value": "custom", "label": "Custom width" }
      ]
    },
    { "type": "range", "id": "custom_section_width", "label": "Custom section width", "min": 720, "max": 2200, "step": 20, "unit": "px", "default": 1500 },

    { "type": "header", "content": "Cards" },
    {
      "type": "select",
      "id": "card_image_ratio",
      "label": "Card image ratio",
      "default": "4-5",
      "options": [
        { "value": "4-5", "label": "Portrait 4:5" },
        { "value": "1-1", "label": "Square 1:1" },
        { "value": "4-3", "label": "Landscape 4:3" },
        { "value": "16-9", "label": "Wide 16:9" }
      ]
    },
    {
      "type": "select",
      "id": "image_hover",
      "label": "Image hover",
      "default": "subtle_zoom",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "subtle_zoom", "label": "Subtle zoom" }
      ]
    },
    { "type": "checkbox", "id": "show_count_default", "label": "Show product count by default", "info": "Applies to cards unless overridden per card block.", "default": true },
    {
      "type": "checkbox",
      "id": "use_first_product_image",
      "label": "Use first product image as fallback",
      "default": true,
      "info": "Uses the first product image when the collection image is missing."
    },

    { "type": "header", "content": "Carousel / grid" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    {
      "type": "select",
      "id": "carousel_cards_desktop",
      "label": "Cards visible desktop",
      "default": "4",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ]
    },
    {
      "type": "select",
      "id": "carousel_cards_tablet",
      "label": "Cards visible tablet",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "select",
      "id": "carousel_cards_mobile",
      "label": "Cards visible mobile",
      "default": "1.2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "1.2", "label": "1.2" },
        { "value": "1.5", "label": "1.5" },
        { "value": "2", "label": "2" }
      ]
    },
    { "type": "range", "id": "gap_desktop", "label": "Gap desktop", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "gap_mobile", "label": "Gap mobile", "min": 0, "max": 28, "step": 1, "unit": "px", "default": 12 },

    { "type": "header", "content": "Card text" },
    { "type": "range", "id": "card_title_size_desktop", "label": "Card title size desktop", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_title_size_mobile", "label": "Card title size mobile", "min": 11, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "select", "id": "card_title_weight", "label": "Card title weight", "default": "800", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }] },
    { "type": "range", "id": "card_title_line_height", "label": "Card title line height", "min": 80, "max": 180, "step": 5, "unit": "%", "default": 120 },
    { "type": "range", "id": "card_title_letter_spacing", "label": "Card title letter spacing", "min": -10, "max": 40, "step": 1, "unit": "em", "default": 0 },
    { "type": "select", "id": "card_title_transform", "label": "Card title text transform", "default": "uppercase", "options": [{ "value": "none", "label": "None" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "lowercase", "label": "Lowercase" }, { "value": "capitalize", "label": "Capitalize" }] },
    { "type": "color", "id": "card_title_color", "label": "Card title colour", "default": "#ffffff" },
    { "type": "header", "content": "Card meta" },
    { "type": "range", "id": "card_meta_size_desktop", "label": "Card meta size desktop", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "card_meta_size_mobile", "label": "Card meta size mobile", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 10 },
    { "type": "select", "id": "card_meta_weight", "label": "Card meta weight", "default": "600", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }] },
    { "type": "range", "id": "card_meta_line_height", "label": "Card meta line height", "min": 80, "max": 220, "step": 5, "unit": "%", "default": 130 },
