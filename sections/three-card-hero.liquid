{{ 'section-three-card-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign width_mode = section.settings.section_width | default: 'full'
  assign custom_width = section.settings.custom_section_width | default: 1440
  assign overlay_color = section.settings.overlay_color | default: '#000000'
  assign overlay_opacity = section.settings.overlay_opacity | default: 20 | divided_by: 100.0
  assign section_background = section.settings.section_background | default: 'var(--color-background)'

  assign section_width_value = 'var(--page-width)'
  if width_mode == 'full'
    assign section_width_value = 'none'
  elsif width_mode == 'custom'
    capture section_width_value
      echo custom_width
      echo 'px'
    endcapture
  endif

  assign card_count = section.blocks.size
  if card_count == 0 or card_count > 3
    assign card_count = 3
  endif
-%}

<section
  class="yaomri-three-hero cnvrt-three-hero yaomri-three-hero--width-{{ width_mode }} cnvrt-three-hero--width-{{ width_mode }}{% if section.settings.show_border %} yaomri-three-hero--border cnvrt-three-hero--border{% endif %} full-width"
  style="
    --cnvrt-three-hero-section-width: {{ section_width_value }};
    --cnvrt-three-hero-section-bg: {{ section_background }};
    --cnvrt-three-hero-overlay-color: {{ overlay_color }};
    --cnvrt-three-hero-overlay-opacity: {{ overlay_opacity }};
    --cnvrt-three-hero-height-desktop: {{ section.settings.section_height_desktop }}px;
    --cnvrt-three-hero-height-mobile: {{ section.settings.section_height_mobile }}px;
    --cnvrt-three-hero-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --cnvrt-three-hero-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --cnvrt-three-hero-padding-left-desktop: {{ section.settings.padding_left_desktop }}px;
    --cnvrt-three-hero-padding-right-desktop: {{ section.settings.padding_right_desktop }}px;
    --cnvrt-three-hero-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --cnvrt-three-hero-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --cnvrt-three-hero-padding-left-mobile: {{ section.settings.padding_left_mobile }}px;
    --cnvrt-three-hero-padding-right-mobile: {{ section.settings.padding_right_mobile }}px;
    --cnvrt-three-hero-margin-top-desktop: {{ section.settings.margin_top_desktop }}px;
    --cnvrt-three-hero-margin-bottom-desktop: {{ section.settings.margin_bottom_desktop }}px;
    --cnvrt-three-hero-margin-top-mobile: {{ section.settings.margin_top_mobile }}px;
    --cnvrt-three-hero-margin-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;

    --yth-section-width: var(--cnvrt-three-hero-section-width);
    --yth-section-bg: var(--cnvrt-three-hero-section-bg);
    --yth-overlay-color: var(--cnvrt-three-hero-overlay-color);
    --yth-overlay-opacity: var(--cnvrt-three-hero-overlay-opacity);
    --yth-height-desktop: var(--cnvrt-three-hero-height-desktop);
    --yth-height-mobile: var(--cnvrt-three-hero-height-mobile);
    --yth-padding-top-desktop: var(--cnvrt-three-hero-padding-top-desktop);
    --yth-padding-bottom-desktop: var(--cnvrt-three-hero-padding-bottom-desktop);
    --yth-padding-left-desktop: var(--cnvrt-three-hero-padding-left-desktop);
    --yth-padding-right-desktop: var(--cnvrt-three-hero-padding-right-desktop);
    --yth-padding-top-mobile: var(--cnvrt-three-hero-padding-top-mobile);
    --yth-padding-bottom-mobile: var(--cnvrt-three-hero-padding-bottom-mobile);
    --yth-padding-left-mobile: var(--cnvrt-three-hero-padding-left-mobile);
    --yth-padding-right-mobile: var(--cnvrt-three-hero-padding-right-mobile);
    --yth-margin-top-desktop: var(--cnvrt-three-hero-margin-top-desktop);
    --yth-margin-bottom-desktop: var(--cnvrt-three-hero-margin-bottom-desktop);
    --yth-margin-top-mobile: var(--cnvrt-three-hero-margin-top-mobile);
    --yth-margin-bottom-mobile: var(--cnvrt-three-hero-margin-bottom-mobile);
  "
  {{ section.shopify_attributes }}
>
  <div class="yaomri-three-hero__frame cnvrt-three-hero__frame">
    <div class="yaomri-three-hero__cards cnvrt-three-hero__cards yaomri-three-hero__cards--count-{{ card_count }} cnvrt-three-hero__cards--count-{{ card_count }}">
      {%- assign rendered_cards = 0 -%}
      {%- for block in section.blocks limit: 3 -%}
        {%- if block.type == 'hero_card' -%}
          {%- assign rendered_cards = rendered_cards | plus: 1 -%}
          {%- liquid
            assign card_position = block.settings.image_position | default: 'center center'
            assign card_tag = 'div'
            assign has_card_button = false
            if block.settings.link != blank
              assign card_tag = 'a'
            endif
            if block.settings.card_link_label != blank and block.settings.link != blank
              assign has_card_button = true
            endif
          -%}
          <{{ card_tag }}
            class="yaomri-three-hero__card cnvrt-three-hero__card{% if block.settings.link != blank %} yaomri-three-hero__card-link cnvrt-three-hero__card-link{% endif %}"
            {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
            style="--cnvrt-three-hero-image-position: {{ card_position }}; --yth-image-position: var(--cnvrt-three-hero-image-position);"
            {{ block.shopify_attributes }}
          >
            <div class="yaomri-three-hero__media cnvrt-three-hero__media">
              {%- if block.settings.image != blank -%}
                {%- assign card_image_class = 'yaomri-three-hero__image cnvrt-three-hero__image' -%}
                {%- if block.settings.mobile_image != blank -%}
                  {%- assign card_image_class = card_image_class | append: ' yaomri-three-hero__image--has-mobile cnvrt-three-hero__image--has-mobile' -%}
                {%- endif -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    class: card_image_class,
                    widths: '360, 540, 720, 960, 1200, 1400',
                    sizes: '(min-width: 750px) 33vw, 100vw',
                    loading: 'lazy',
                    alt: block.settings.image.alt | default: block.settings.heading | escape
                }}
              {%- else -%}
                <div class="yaomri-three-hero__placeholder cnvrt-three-hero__placeholder" data-label="Add image"></div>
              {%- endif -%}
              {%- if block.settings.mobile_image != blank -%}
                {{
                  block.settings.mobile_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'yaomri-three-hero__image cnvrt-three-hero__image yaomri-three-hero__mobile-image cnvrt-three-hero__mobile-image',
                    widths: '360, 540, 720, 900',
                    sizes: '100vw',
                    loading: 'lazy',
                    alt: block.settings.mobile_image.alt | default: block.settings.heading | escape
                }}
              {%- endif -%}
            </div>
            <div class="yaomri-three-hero__overlay cnvrt-three-hero__overlay"></div>
            <div class="yaomri-three-hero__content cnvrt-three-hero__content">
              {%- if block.settings.eyebrow != blank -%}
                <p class="yaomri-three-hero__eyebrow cnvrt-three-hero__eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="yaomri-three-hero__heading cnvrt-three-hero__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="yaomri-three-hero__text cnvrt-three-hero__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if has_card_button -%}
                <span class="yaomri-three-hero__button cnvrt-three-hero__button"><span>{{ block.settings.card_link_label }}</span></span>
              {%- endif -%}
            </div>
          </{{ card_tag }}>
        {%- endif -%}
      {%- endfor -%}

      {%- if rendered_cards == 0 -%}
        {%- for index in (1..3) -%}
          <div class="yaomri-three-hero__card cnvrt-three-hero__card yaomri-three-hero__card--placeholder cnvrt-three-hero__card--placeholder">
            <div class="yaomri-three-hero__placeholder cnvrt-three-hero__placeholder" data-label="Hero card {{ index }}"></div>
            <div class="yaomri-three-hero__content cnvrt-three-hero__content">
              <p class="yaomri-three-hero__eyebrow cnvrt-three-hero__eyebrow">Edit card {{ index }}</p>
              <h2 class="yaomri-three-hero__heading cnvrt-three-hero__heading">Swim Edit</h2>
              <div class="yaomri-three-hero__text cnvrt-three-hero__text">Add imagery, copy and links in the theme editor.</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "3-Card Hero",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full",
      "options": [
        {
          "value": "site",
          "label": "Site width"
        },
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "range",
      "id": "custom_section_width",
      "label": "Custom section width",
      "min": 720,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "section_height_desktop",
      "label": "Desktop card height",
      "min": 320,
      "max": 840,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Mobile card height",
      "min": 320,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show outer border",
      "default": false
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Image overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Shared overlay colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Shared overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Advanced spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "label": "Padding left desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "label": "Padding right desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Padding left mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Padding right mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Margin top desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Margin bottom desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Margin top mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Margin bottom mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "hero_card",
      "name": "Hero card",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional. Replaces the card image on mobile."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Edit"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Swim"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "card_link_label",
          "label": "Card link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "default": "center center",
          "options": [
            {
              "value": "center center",
              "label": "Centre"
            },
            {
              "value": "center top",
              "label": "Top"
            },
            {
              "value": "center bottom",
              "label": "Bottom"
            },
            {
              "value": "left center",
              "label": "Left"
            },
            {
              "value": "right center",
              "label": "Right"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "3-Card Hero",
      "blocks": [
        {
          "type": "hero_card",
          "settings": {
            "eyebrow": "01",
            "heading": "Bikinis"
          }
        },
        {
          "type": "hero_card",
          "settings": {
            "eyebrow": "02",
            "heading": "Swimsuits"
          }
        },
        {
          "type": "hero_card",
          "settings": {
            "eyebrow": "03",
            "heading": "Resort"
          }
        }
      ]
    }
  ]
}
