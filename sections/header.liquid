{{ 'yaomri-header.css' | asset_url | stylesheet_tag }}
{{ 'mega-menu.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mega-menu.js' | asset_url }}" defer></script>
<script src="{{ 'yaomri-header-state.js' | asset_url }}" defer></script>

{%- liquid
  assign resolved_layout = settings.desktop_layout | default: 'logo_left_nav_center_actions_right'
  unless resolved_layout == 'logo_left_nav_center_actions_right' or resolved_layout == 'nav_left_logo_center_actions_right'
    assign resolved_layout = 'logo_left_nav_center_actions_right'
  endunless

  assign menu_handle = settings.header_menu
  if menu_handle == blank
    assign menu_handle = 'main-menu'
  endif

  assign navigation_menu = linklists[menu_handle]
  if navigation_menu == blank and menu_handle != 'main-menu'
    assign navigation_menu = linklists['main-menu']
  endif

  assign wishlist_url = settings.wishlist_link | default: '/pages/wishlist'
  assign show_country_selector = settings.show_country_selector
  assign country_selector_style = settings.country_selector_style | default: 'full'
  unless country_selector_style == 'compact' or country_selector_style == 'full'
    assign country_selector_style = 'full'
  endunless
  assign country_selector_show_currency = settings.country_selector_show_currency
  capture country_selector_class
    echo 'yaomri-header__country-selector cnvrt-header__country-selector yaomri-header__country-selector--'
    echo country_selector_style
    echo ' cnvrt-header__country-selector--'
    echo country_selector_style
    if country_selector_show_currency
      echo ' yaomri-header__country-selector--currency cnvrt-header__country-selector--currency'
    endif
  endcapture
  assign country_selector_class = country_selector_class | strip
  assign show_account_icon = settings.show_account_icon
  assign show_wishlist_icon = settings.show_wishlist_icon
  assign show_cart_icon = settings.show_cart_icon
  assign desktop_logo = settings.logo
  assign mobile_logo = settings.mobile_logo | default: settings.logo
  assign transparent_logo = settings.transparent_logo | default: settings.logo
  assign transparent_mobile_logo = settings.transparent_mobile_logo
  if transparent_mobile_logo == blank
    assign transparent_mobile_logo = settings.transparent_logo | default: mobile_logo
  endif
  assign desktop_logo_width = settings.desktop_logo_width | default: 180
  assign mobile_logo_width = settings.mobile_logo_width | default: 140
  assign header_width_mode = settings.header_width_mode | default: 'site'
  unless header_width_mode == 'site' or header_width_mode == 'full' or header_width_mode == 'custom'
    assign header_width_mode = 'site'
  endunless
  assign header_custom_width = settings.header_custom_width | default: 1200
  assign nav_collapse_width = settings.nav_collapse_width | default: '1100'
  assign show_bottom_border = settings.show_bottom_border
  assign enable_sticky = settings.enable_sticky
  assign header_background = settings.header_background | default: '#ffffff'
  assign header_foreground = settings.header_foreground | default: '#111111'
  assign header_border = settings.header_border | default: '#e8e8e8'
  assign header_desktop_padding = 24
  assign header_mobile_padding = 16
  assign desktop_header_height = settings.desktop_header_height | default: 82
  assign mobile_header_height = settings.mobile_header_height | default: 74
  assign icon_size = settings.icon_size | default: 24
  assign icon_button_size_desktop = settings.icon_button_size_desktop | default: 44
  assign icon_button_size_mobile = settings.icon_button_size_mobile | default: 42
  assign desktop_icon_gap = settings.desktop_icon_gap | default: 0
  assign mobile_icon_gap = settings.mobile_icon_gap | default: 0
  assign nav_text_size = settings.nav_text_size | default: 12
  assign nav_gap = settings.nav_gap | default: 24
  assign cart_count_background = settings.cart_count_background | default: '#000000'
  assign cart_count_text = settings.cart_count_text | default: '#ffffff'
  assign cart_count_size = settings.cart_count_size | default: 18
  assign cart_count_text_size = settings.cart_count_text_size | default: 10
  assign cart_count_offset_x = settings.cart_count_offset_x | default: 4
  assign cart_count_offset_y = settings.cart_count_offset_y | default: 5
  assign country_selector_background = settings.country_selector_background
  if country_selector_background == blank
    assign country_selector_background = 'var(--color-background)'
  endif
  assign country_selector_border = settings.country_selector_border
  if country_selector_border == blank
    assign country_selector_border = 'var(--color-border)'
  endif
  assign country_selector_text = settings.country_selector_text
  if country_selector_text == blank
    assign country_selector_text = 'currentColor'
  endif
  assign country_selector_height = settings.country_selector_height | default: 48
  assign transparent_header_mode = settings.transparent_header_mode | default: 'homepage'
  unless transparent_header_mode == 'off' or transparent_header_mode == 'homepage' or transparent_header_mode == 'all'
    assign transparent_header_mode = 'homepage'
  endunless
  assign transparent_header_active = false
  if transparent_header_mode == 'all'
    assign transparent_header_active = true
  elsif transparent_header_mode == 'homepage' and request.page_type == 'index'
    assign transparent_header_active = true
  endif
  assign transparent_header_colour_scheme = settings.transparent_header_colour_scheme | default: 'light'
  unless transparent_header_colour_scheme == 'light' or transparent_header_colour_scheme == 'dark' or transparent_header_colour_scheme == 'custom'
    assign transparent_header_colour_scheme = 'light'
  endunless
  assign transparent_header_text_colour = settings.transparent_header_text_colour | default: '#ffffff'
  assign transparent_header_resolved_text = transparent_header_text_colour
  if transparent_header_colour_scheme == 'light'
    assign transparent_header_resolved_text = '#ffffff'
  elsif transparent_header_colour_scheme == 'dark'
    assign transparent_header_resolved_text = '#111111'
  endif
  assign transparent_header_bg_opacity = settings.transparent_header_background_opacity | default: 0 | divided_by: 100.0
  assign transparent_header_border = settings.transparent_header_border_colour | default: '#00000000'
  assign transparent_header_solid_after_scroll = settings.transparent_header_solid_after_scroll
  assign transparent_header_solid_background = settings.transparent_header_solid_background
  if transparent_header_solid_background == blank
    assign transparent_header_solid_background = header_background
  endif
  assign transparent_header_solid_text = settings.transparent_header_solid_text_colour
  if transparent_header_solid_text == blank
    assign transparent_header_solid_text = header_foreground
  endif
  assign header_stack_scroll_behavior = settings.header_stack_scroll_behavior | default: 'always_visible'
  unless header_stack_scroll_behavior == 'always_visible' or header_stack_scroll_behavior == 'fade_away_after_scroll'
    assign header_stack_scroll_behavior = 'always_visible'
  endunless
  assign header_stack_scroll_threshold = settings.header_stack_scroll_threshold | default: 40
  assign header_stack_scroll_threshold_mobile = settings.header_stack_scroll_threshold_mobile | default: 24
  assign header_stack_transition = settings.header_stack_transition | default: 'fade_slide'
  unless header_stack_transition == 'fade' or header_stack_transition == 'slide' or header_stack_transition == 'fade_slide'
    assign header_stack_transition = 'fade_slide'
  endunless
  assign header_stack_transition_duration = settings.header_stack_transition_duration | default: 350
  assign header_stack_transition_easing = settings.header_stack_transition_easing | default: 'smooth'
  unless header_stack_transition_easing == 'ease' or header_stack_transition_easing == 'smooth' or header_stack_transition_easing == 'snappy' or header_stack_transition_easing == 'linear'
    assign header_stack_transition_easing = 'smooth'
  endunless
  assign header_stack_transition_easing_value = 'cubic-bezier(0.22, 1, 0.36, 1)'
  case header_stack_transition_easing
    when 'ease'
      assign header_stack_transition_easing_value = 'ease'
    when 'snappy'
      assign header_stack_transition_easing_value = 'cubic-bezier(0.4, 0, 0.2, 1)'
    when 'linear'
      assign header_stack_transition_easing_value = 'linear'
  endcase
  assign current_country_name = localization.country.name
  if current_country_name == blank
    assign current_country_name = localization.country.iso_code
  endif
  assign current_country_currency = localization.country.currency.iso_code
  capture current_country_label
    if country_selector_style == 'full'
      echo current_country_name
    else
      echo localization.country.iso_code
    endif
    if country_selector_show_currency and current_country_currency != blank
      echo ' / '
      echo current_country_currency
    endif
  endcapture
  assign current_country_label = current_country_label | strip
  assign header_shadow = settings.header_shadow | default: 'none'
  assign header_shadow_value = 'none'
  case header_shadow
    when 'subtle'
      assign header_shadow_value = '0 6px 16px -12px rgba(0, 0, 0, 0.12)'
    when 'medium'
      assign header_shadow_value = '0 12px 24px -16px rgba(0, 0, 0, 0.18)'
    when 'strong'
      assign header_shadow_value = '0 18px 36px -20px rgba(0, 0, 0, 0.26)'
    when 'custom'
      assign shadow_offset_y = settings.header_shadow_offset_y | default: 8
      assign shadow_blur = settings.header_shadow_blur | default: 24
      assign shadow_opacity = settings.header_shadow_opacity | default: 10
      capture header_shadow_custom
        echo '0 '
        echo shadow_offset_y
        echo 'px '
        echo shadow_blur
        echo 'px rgb(0 0 0 / '
        echo shadow_opacity
        echo '%)'
      endcapture
      assign header_shadow_value = header_shadow_custom | strip
  endcase

-%}

{%- if enable_sticky and transparent_header_active == false -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: 60;
    }
  {%- endstyle -%}
{%- endif -%}

<header
  class="yaomri-header cnvrt-header full-width yaomri-header--layout-{{ resolved_layout }} cnvrt-header--layout-{{ resolved_layout }} yaomri-header--width-{{ header_width_mode }} cnvrt-header--width-{{ header_width_mode }} yaomri-header--collapse-{{ nav_collapse_width }} cnvrt-header--collapse-{{ nav_collapse_width }}{% unless show_bottom_border %} yaomri-header--no-border cnvrt-header--no-border{% endunless %}{% if transparent_header_active %} yaomri-header--transparent-active cnvrt-header--transparent-active{% endif %}{% if enable_sticky %} yaomri-header--sticky-enabled cnvrt-header--sticky-enabled{% endif %}"
  role="banner"
  aria-label="Site header"
  id="SiteHeader"
  data-transparent-mode="{{ transparent_header_mode }}"
  data-transparent-active="{% if transparent_header_active %}true{% else %}false{% endif %}"
  data-transparent-solid-after-scroll="{% if transparent_header_solid_after_scroll %}true{% else %}false{% endif %}"
  data-header-stack-scroll-behavior="{{ header_stack_scroll_behavior }}"
  data-cnvrt-header-stack-scroll-behavior="{{ header_stack_scroll_behavior }}"
  data-header-stack-scroll-threshold="{{ header_stack_scroll_threshold }}"
  data-cnvrt-header-stack-scroll-threshold="{{ header_stack_scroll_threshold }}"
  data-header-stack-scroll-threshold-mobile="{{ header_stack_scroll_threshold_mobile }}"
  data-cnvrt-header-stack-scroll-threshold-mobile="{{ header_stack_scroll_threshold_mobile }}"
  data-header-stack-transition="{{ header_stack_transition }}"
  data-cnvrt-header-stack-transition="{{ header_stack_transition }}"
  data-header-stack-transition-duration="{{ header_stack_transition_duration }}"
  data-cnvrt-header-stack-transition-duration="{{ header_stack_transition_duration }}"
  data-header-stack-transition-easing="{{ header_stack_transition_easing }}"
  data-cnvrt-header-stack-transition-easing="{{ header_stack_transition_easing }}"
  data-header-desktop-padding="{{ header_desktop_padding }}"
  style="
    --cnvrt-header-bg: {{ header_background }};
    --cnvrt-header-fg: {{ header_foreground }};
    --cnvrt-header-border: {{ header_border }};
    --cnvrt-header-shadow: {{ header_shadow_value }};
    --cnvrt-header-custom-content-width: {{ header_custom_width }}px;
    --cnvrt-header-desktop-padding: {{ header_desktop_padding }}px;
    --cnvrt-header-mobile-padding: {{ header_mobile_padding }}px;
    --cnvrt-header-desktop-height: {{ desktop_header_height }}px;
    --cnvrt-header-mobile-height: {{ mobile_header_height }}px;
    --cnvrt-header-desktop-logo-width: {{ desktop_logo_width }}px;
    --cnvrt-header-mobile-logo-width: {{ mobile_logo_width }}px;
    --cnvrt-header-icon-size: {{ icon_size }}px;
    --cnvrt-header-icon-button-desktop: {{ icon_button_size_desktop }}px;
    --cnvrt-header-icon-button-mobile: {{ icon_button_size_mobile }}px;
    --cnvrt-header-desktop-icon-gap: {{ desktop_icon_gap }}px;
    --cnvrt-header-mobile-icon-gap: {{ mobile_icon_gap }}px;
    --cnvrt-header-nav-size: {{ nav_text_size }}px;
    --cnvrt-header-nav-gap: {{ nav_gap }}px;
    --cnvrt-header-cart-count-bg: {{ cart_count_background }};
    --cnvrt-header-cart-count-text: {{ cart_count_text }};
    --cnvrt-header-cart-count-size: {{ cart_count_size }}px;
    --cnvrt-header-cart-count-font-size: {{ cart_count_text_size }}px;
    --cnvrt-header-cart-count-offset-x: {{ cart_count_offset_x }}px;
    --cnvrt-header-cart-count-offset-y: {{ cart_count_offset_y }}px;
    --cnvrt-header-country-bg-normal: {{ country_selector_background }};
    --cnvrt-header-country-border-normal: {{ country_selector_border }};
    --cnvrt-header-country-text-normal: {{ country_selector_text }};
    --cnvrt-header-country-bg: var(--cnvrt-header-country-bg-normal);
    --cnvrt-header-country-border: var(--cnvrt-header-country-border-normal);
    --cnvrt-header-country-text: var(--cnvrt-header-country-text-normal);
    --cnvrt-header-country-height: {{ country_selector_height }}px;
    --cnvrt-header-transparent-text: {{ transparent_header_resolved_text }};
    --cnvrt-header-transparent-bg-opacity: {{ transparent_header_bg_opacity }};
    --cnvrt-header-transparent-border: {{ transparent_header_border }};
    --cnvrt-header-solid-after-scroll-bg: {{ transparent_header_solid_background }};
    --cnvrt-header-solid-after-scroll-text: {{ transparent_header_solid_text }};
    --cnvrt-header-stack-transition-duration: {{ header_stack_transition_duration }}ms;
    --cnvrt-header-stack-transition-easing: {{ header_stack_transition_easing_value }};
    --cnvrt-header-stack-scroll-threshold-desktop: {{ header_stack_scroll_threshold }};
    --cnvrt-header-stack-scroll-threshold-mobile: {{ header_stack_scroll_threshold_mobile }};

    --yh-bg: var(--cnvrt-header-bg);
    --yh-fg: var(--cnvrt-header-fg);
    --yh-border: var(--cnvrt-header-border);
    --yh-shadow: var(--cnvrt-header-shadow);
    --yh-custom-content-width: var(--cnvrt-header-custom-content-width);
    --yh-desktop-padding: var(--cnvrt-header-desktop-padding);
    --yh-mobile-padding: var(--cnvrt-header-mobile-padding);
    --yh-desktop-height: var(--cnvrt-header-desktop-height);
    --yh-mobile-height: var(--cnvrt-header-mobile-height);
    --yh-desktop-logo-width: var(--cnvrt-header-desktop-logo-width);
    --yh-mobile-logo-width: var(--cnvrt-header-mobile-logo-width);
    --yh-icon-size: var(--cnvrt-header-icon-size);
    --yh-icon-button-desktop: var(--cnvrt-header-icon-button-desktop);
    --yh-icon-button-mobile: var(--cnvrt-header-icon-button-mobile);
    --yh-desktop-icon-gap: var(--cnvrt-header-desktop-icon-gap);
    --yh-mobile-icon-gap: var(--cnvrt-header-mobile-icon-gap);
    --yh-nav-size: var(--cnvrt-header-nav-size);
    --yh-nav-gap: var(--cnvrt-header-nav-gap);
    --yh-cart-count-bg: var(--cnvrt-header-cart-count-bg);
    --yh-cart-count-text: var(--cnvrt-header-cart-count-text);
    --yh-cart-count-size: var(--cnvrt-header-cart-count-size);
    --yh-cart-count-font-size: var(--cnvrt-header-cart-count-font-size);
    --yh-cart-count-offset-x: var(--cnvrt-header-cart-count-offset-x);
    --yh-cart-count-offset-y: var(--cnvrt-header-cart-count-offset-y);
    --yh-country-bg-normal: var(--cnvrt-header-country-bg-normal);
    --yh-country-border-normal: var(--cnvrt-header-country-border-normal);
    --yh-country-text-normal: var(--cnvrt-header-country-text-normal);
    --yh-country-bg: var(--cnvrt-header-country-bg);
    --yh-country-border: var(--cnvrt-header-country-border);
    --yh-country-text: var(--cnvrt-header-country-text);
    --yh-country-height: var(--cnvrt-header-country-height);
    --yh-transparent-text: var(--cnvrt-header-transparent-text);
    --yh-transparent-bg-opacity: var(--cnvrt-header-transparent-bg-opacity);
    --yh-transparent-border: var(--cnvrt-header-transparent-border);
    --yh-solid-after-scroll-bg: var(--cnvrt-header-solid-after-scroll-bg);
    --yh-solid-after-scroll-text: var(--cnvrt-header-solid-after-scroll-text);
    --yaomri-header-stack-transition-duration: var(--cnvrt-header-stack-transition-duration);
    --yaomri-header-stack-transition-easing: var(--cnvrt-header-stack-transition-easing);
    --yaomri-header-stack-scroll-threshold-desktop: var(--cnvrt-header-stack-scroll-threshold-desktop);
    --yaomri-header-stack-scroll-threshold-mobile: var(--cnvrt-header-stack-scroll-threshold-mobile);
  "
  {{ section.shopify_attributes }}
>
  {%- capture logo_markup -%}
    <a href="{{ routes.root_url }}" class="yaomri-header__logo-link cnvrt-header__logo-link" aria-label="{{ shop.name | escape }}">
      {%- if desktop_logo != blank -%}
        {{
          desktop_logo
          | image_url: width: 800
          | image_tag:
            class: 'yaomri-header__logo-image cnvrt-header__logo-image',
            widths: '120, 160, 200, 240, 300, 360, 420, 520, 680, 800',
            sizes: '(min-width: 990px) var(--yh-desktop-logo-width), var(--yh-mobile-logo-width)',
            loading: 'eager',
            alt: desktop_logo.alt | default: shop.name | escape
        }}
        {%- if transparent_logo != blank -%}
          {{
            transparent_logo
            | image_url: width: 800
            | image_tag:
              class: 'yaomri-header__logo-image cnvrt-header__logo-image yaomri-header__logo-image--transparent cnvrt-header__logo-image--transparent',
              widths: '120, 160, 200, 240, 300, 360, 420, 520, 680, 800',
              sizes: '(min-width: 990px) var(--yh-desktop-logo-width), var(--yh-mobile-logo-width)',
              loading: 'eager',
              alt: transparent_logo.alt | default: shop.name | escape
          }}
        {%- endif -%}
      {%- else -%}
        <span class="yaomri-header__shop-name cnvrt-header__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  {%- endcapture -%}

  {%- capture mobile_logo_markup -%}
    <a href="{{ routes.root_url }}" class="yaomri-header__logo-link cnvrt-header__logo-link yaomri-header__logo-link--mobile cnvrt-header__logo-link--mobile" aria-label="{{ shop.name | escape }}">
      {%- if mobile_logo != blank -%}
        {{
          mobile_logo
          | image_url: width: 640
          | image_tag:
            class: 'yaomri-header__logo-image cnvrt-header__logo-image',
            widths: '100, 140, 180, 220, 280, 360, 480, 640',
            sizes: '(max-width: 989px) var(--yh-mobile-logo-width), var(--yh-desktop-logo-width)',
            loading: 'eager',
            alt: mobile_logo.alt | default: shop.name | escape
        }}
        {%- if transparent_mobile_logo != blank -%}
          {{
            transparent_mobile_logo
            | image_url: width: 640
            | image_tag:
              class: 'yaomri-header__logo-image cnvrt-header__logo-image yaomri-header__logo-image--transparent cnvrt-header__logo-image--transparent',
              widths: '100, 140, 180, 220, 280, 360, 480, 640',
              sizes: '(max-width: 989px) var(--yh-mobile-logo-width), var(--yh-desktop-logo-width)',
              loading: 'eager',
              alt: transparent_mobile_logo.alt | default: shop.name | escape
          }}
        {%- endif -%}
      {%- else -%}
        <span class="yaomri-header__shop-name cnvrt-header__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  {%- endcapture -%}

  {%- capture nav_markup -%}
    {% render 'mega-menu', section: section, fallback_menu: navigation_menu %}
  {%- endcapture -%}

  {%- capture actions_markup -%}
    <div class="yaomri-header__actions cnvrt-header__actions">
      {%- if show_country_selector and localization.available_countries.size > 1 -%}
        {%- form 'localization', id: 'HeaderCountryForm', class: country_selector_class -%}
          <label class="visually-hidden" for="HeaderCountrySelector">Country/region</label>
          <span class="yaomri-header__country-current cnvrt-header__country-current" aria-hidden="true">
            {{ current_country_label }}
          </span>
          <select
            id="HeaderCountrySelector"
            class="yaomri-header__country-select cnvrt-header__country-select"
            name="country_code"
            aria-label="Country/region"
            onchange="this.form.submit()"
          >
            {%- for country in localization.available_countries -%}
              {%- assign option_country_name = country.name | default: country.iso_code -%}
              {%- assign option_currency_code = country.currency.iso_code -%}
              {%- capture country_label -%}
                {%- if country_selector_style == 'full' -%}
                  {{- option_country_name -}}
                {%- else -%}
                  {{- country.iso_code -}}
                {%- endif -%}
                {%- if country_selector_show_currency and option_currency_code != blank -%} / {{ option_currency_code }}{%- endif -%}
              {%- endcapture -%}
              <option
                value="{{ country.iso_code }}"
                {%- if country.iso_code == localization.country.iso_code -%} selected{%- endif -%}
              >
                {{ country_label | strip }}
              </option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}

      <a class="yaomri-header__icon cnvrt-header__icon" href="{{ routes.search_url }}" aria-label="Search">
        {% render 'icon-yaomri-search' %}
      </a>

      {%- if show_account_icon and shop.customer_accounts_enabled -%}
        <a class="yaomri-header__icon cnvrt-header__icon" href="{{ routes.account_url }}" aria-label="Account">
          {% render 'icon-yaomri-account' %}
        </a>
      {%- endif -%}

      {%- if show_wishlist_icon -%}
        <a class="yaomri-header__icon cnvrt-header__icon" href="{{ wishlist_url }}" aria-label="Wishlist">
          {% render 'icon-yaomri-heart' %}
        </a>
      {%- endif -%}

      {%- if show_cart_icon -%}
        <a class="yaomri-header__icon cnvrt-header__icon yaomri-header__cart cnvrt-header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
          {% render 'icon-yaomri-cart' %}
          {%- if cart.item_count > 0 -%}
            <span id="cart-icon-bubble" class="yaomri-header__cart-count cnvrt-header__cart-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  {%- endcapture -%}

  <div class="yaomri-header__desktop cnvrt-header__desktop">
    <div class="yaomri-header__desktop-left cnvrt-header__desktop-left">
      {%- if resolved_layout == 'logo_left_nav_center_actions_right' -%}
        {{ logo_markup }}
      {%- elsif resolved_layout == 'nav_left_logo_center_actions_right' -%}
        {{ nav_markup }}
      {%- endif -%}
    </div>

    <div class="yaomri-header__desktop-centre cnvrt-header__desktop-centre">
      {%- if resolved_layout == 'logo_left_nav_center_actions_right' -%}
        {{ nav_markup }}
      {%- else -%}
        {{ logo_markup }}
      {%- endif -%}
    </div>

    <div class="yaomri-header__desktop-right cnvrt-header__desktop-right">
      {{ actions_markup }}
    </div>
  </div>

  <div class="yaomri-header__mobile cnvrt-header__mobile">
    <div class="yaomri-header__mobile-left cnvrt-header__mobile-left">
      <button
        class="yaomri-header__icon cnvrt-header__icon"
        type="button"
        data-mdrawer-trigger
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="MobileDrawer"
      >
        {% render 'icon-yaomri-menu' %}
      </button>
    </div>

    <div class="yaomri-header__mobile-center cnvrt-header__mobile-center">
      {{ mobile_logo_markup }}
    </div>

    <div class="yaomri-header__mobile-right cnvrt-header__mobile-right">
      <a class="yaomri-header__icon cnvrt-header__icon" href="{{ routes.search_url }}" aria-label="Search">
        {% render 'icon-yaomri-search' %}
      </a>

      {%- if show_wishlist_icon -%}
        <a class="yaomri-header__icon cnvrt-header__icon yaomri-header__mobile-optional cnvrt-header__mobile-optional" href="{{ wishlist_url }}" aria-label="Wishlist">
          {% render 'icon-yaomri-heart' %}
        </a>
      {%- endif -%}

      {%- if show_cart_icon -%}
        <a class="yaomri-header__icon cnvrt-header__icon yaomri-header__cart cnvrt-header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
          {% render 'icon-yaomri-cart' %}
          {%- if cart.item_count > 0 -%}
            <span class="yaomri-header__cart-count cnvrt-header__cart-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</header>

