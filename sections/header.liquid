  "max_blocks": 30,
  "blocks": [
    {
      "type": "base_item",
      "name": "Base item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Open in new window",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "highlight_item",
          "label": "Highlight item",
          "default": false
        },
        {
          "type": "color",
          "id": "highlight_color",
          "label": "Highlight colour",
          "default": "#c0392b"
        },
        {
          "type": "text",
          "id": "label_text",
          "label": "Label text"
        },
        {
          "type": "color",
          "id": "label_color",
          "label": "Label colour",
          "default": "#111111"
        }
      ]
    },
    {
      "type": "dropdown_item",
      "name": "Dropdown item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Dropdown"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Open in new window",
          "default": false
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "select",
          "id": "dropdown_position",
          "label": "Dropdown position",
          "default": "start",
          "options": [
            {
              "value": "start",
              "label": "Start"
            },
            {
              "value": "center",
              "label": "Centre"
            },
            {
              "value": "end",
              "label": "End"
            }
          ]
        },
        {
          "type": "range",
          "id": "dropdown_width",
          "label": "Dropdown panel width",
          "min": 180,
          "max": 520,
          "step": 10,
          "unit": "px",
          "default": 260
