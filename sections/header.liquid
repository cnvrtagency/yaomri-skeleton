{{ 'yaomri-header.css' | asset_url | stylesheet_tag }}
{{ 'mega-menu.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mega-menu.js' | asset_url }}" defer></script>

{%- liquid
  assign resolved_layout = settings.desktop_layout | default: 'logo_left_nav_center_actions_right'
  unless resolved_layout == 'logo_left_nav_center_actions_right' or resolved_layout == 'nav_left_logo_center_actions_right'
    assign resolved_layout = 'logo_left_nav_center_actions_right'
  endunless

  assign menu_handle = settings.header_menu
  if menu_handle == blank
    assign menu_handle = 'main-menu'
  endif

  assign navigation_menu = linklists[menu_handle]
  if navigation_menu == blank and menu_handle != 'main-menu'
    assign navigation_menu = linklists['main-menu']
  endif

  assign wishlist_url = settings.wishlist_link | default: '/pages/wishlist'
  assign show_country_selector = settings.show_country_selector
  assign country_selector_style = settings.country_selector_style | default: 'full'
  unless country_selector_style == 'compact' or country_selector_style == 'full'
    assign country_selector_style = 'full'
  endunless
  assign country_selector_show_flag = settings.country_selector_show_flag
  assign country_selector_show_currency = settings.country_selector_show_currency
  capture country_selector_class
    echo 'yaomri-header__country-selector yaomri-header__country-selector--'
    echo country_selector_style
    if country_selector_show_currency
      echo ' yaomri-header__country-selector--currency'
    endif
  endcapture
  assign country_selector_class = country_selector_class | strip
  assign show_account_icon = settings.show_account_icon
  assign show_wishlist_icon = settings.show_wishlist_icon
  assign show_cart_icon = settings.show_cart_icon
  assign desktop_logo = settings.logo
  assign mobile_logo = settings.mobile_logo | default: settings.logo
  assign desktop_logo_width = settings.desktop_logo_width | default: 180
  assign mobile_logo_width = settings.mobile_logo_width | default: 140
  assign header_width_mode = settings.header_width_mode | default: 'site'
  unless header_width_mode == 'site' or header_width_mode == 'full' or header_width_mode == 'custom'
    assign header_width_mode = 'site'
  endunless
  assign header_custom_width = settings.header_custom_width | default: 1200
  assign nav_collapse_width = settings.nav_collapse_width | default: '1100'
  assign show_bottom_border = settings.show_bottom_border
  assign enable_sticky = settings.enable_sticky
  assign header_background = settings.header_background | default: '#ffffff'
  assign header_foreground = settings.header_foreground | default: '#111111'
  assign header_border = settings.header_border | default: '#e8e8e8'
  assign header_desktop_padding = 24
  assign header_mobile_padding = 16
  assign desktop_header_height = settings.desktop_header_height | default: 82
  assign mobile_header_height = settings.mobile_header_height | default: 74
  assign icon_size = settings.icon_size | default: 24
  assign icon_button_size_desktop = settings.icon_button_size_desktop | default: 44
  assign icon_button_size_mobile = settings.icon_button_size_mobile | default: 42
  assign desktop_icon_gap = settings.desktop_icon_gap | default: 0
  assign mobile_icon_gap = settings.mobile_icon_gap | default: 0
  assign nav_text_size = settings.nav_text_size | default: 12
  assign nav_gap = settings.nav_gap | default: 24
  assign cart_count_background = settings.cart_count_background | default: '#000000'
  assign cart_count_text = settings.cart_count_text | default: '#ffffff'
  assign cart_count_size = settings.cart_count_size | default: 18
  assign cart_count_text_size = settings.cart_count_text_size | default: 10
  assign cart_count_offset_x = settings.cart_count_offset_x | default: 4
  assign cart_count_offset_y = settings.cart_count_offset_y | default: 5
  assign country_selector_background = settings.country_selector_background
  if country_selector_background == blank
    assign country_selector_background = 'var(--color-background)'
  endif
  assign country_selector_border = settings.country_selector_border
  if country_selector_border == blank
    assign country_selector_border = 'var(--color-border)'
  endif
  assign country_selector_text = settings.country_selector_text
  if country_selector_text == blank
    assign country_selector_text = 'currentColor'
  endif
  assign country_selector_height = settings.country_selector_height | default: 48
  capture current_country_flag
    if country_selector_show_flag and localization.country != blank
      render 'country-flag', iso_code: localization.country.iso_code
    endif
  endcapture
  assign current_country_flag = current_country_flag | strip
  assign current_country_name = localization.country.name
  if current_country_name == blank
    assign current_country_name = localization.country.iso_code
  endif
  capture current_country_label
    if current_country_flag != blank
      echo current_country_flag
      echo ' '
    endif
    if country_selector_style == 'full'
      echo current_country_name
    else
      echo localization.country.iso_code
    endif
    if country_selector_show_currency
      echo ' / '
      echo localization.country.currency.iso_code
    endif
  endcapture
  assign current_country_label = current_country_label | strip
  assign header_shadow = settings.header_shadow | default: 'none'
  assign header_shadow_value = 'none'
  case header_shadow
    when 'subtle'
      assign header_shadow_value = '0 6px 16px -12px rgba(0, 0, 0, 0.12)'
    when 'medium'
      assign header_shadow_value = '0 12px 24px -16px rgba(0, 0, 0, 0.18)'
    when 'strong'
      assign header_shadow_value = '0 18px 36px -20px rgba(0, 0, 0, 0.26)'
    when 'custom'
      assign shadow_offset_y = settings.header_shadow_offset_y | default: 8
      assign shadow_blur = settings.header_shadow_blur | default: 24
      assign shadow_opacity = settings.header_shadow_opacity | default: 10
      capture header_shadow_custom
        echo '0 '
        echo shadow_offset_y
        echo 'px '
        echo shadow_blur
        echo 'px rgb(0 0 0 / '
        echo shadow_opacity
        echo '%)'
      endcapture
      assign header_shadow_value = header_shadow_custom | strip
  endcase
-%}

{%- if enable_sticky -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: 60;
    }
  {%- endstyle -%}
{%- endif -%}

<section
  class="yaomri-header full-width yaomri-header--layout-{{ resolved_layout }} yaomri-header--width-{{ header_width_mode }} yaomri-header--collapse-{{ nav_collapse_width }}{% unless show_bottom_border %} yaomri-header--no-border{% endunless %}"
  data-header-desktop-padding="{{ header_desktop_padding }}"
  style="
    --yh-bg: {{ header_background }};
    --yh-fg: {{ header_foreground }};
    --yh-border: {{ header_border }};
    --yh-shadow: {{ header_shadow_value }};
    --yh-custom-content-width: {{ header_custom_width }}px;
    --yh-desktop-padding: {{ header_desktop_padding }}px;
    --yh-mobile-padding: {{ header_mobile_padding }}px;
    --yh-desktop-height: {{ desktop_header_height }}px;
    --yh-mobile-height: {{ mobile_header_height }}px;
    --yh-desktop-logo-width: {{ desktop_logo_width }}px;
    --yh-mobile-logo-width: {{ mobile_logo_width }}px;
    --yh-icon-size: {{ icon_size }}px;
    --yh-icon-button-desktop: {{ icon_button_size_desktop }}px;
    --yh-icon-button-mobile: {{ icon_button_size_mobile }}px;
    --yh-desktop-icon-gap: {{ desktop_icon_gap }}px;
    --yh-mobile-icon-gap: {{ mobile_icon_gap }}px;
    --yh-nav-size: {{ nav_text_size }}px;
    --yh-nav-gap: {{ nav_gap }}px;
    --yh-cart-count-bg: {{ cart_count_background }};
    --yh-cart-count-text: {{ cart_count_text }};
    --yh-cart-count-size: {{ cart_count_size }}px;
    --yh-cart-count-font-size: {{ cart_count_text_size }}px;
    --yh-cart-count-offset-x: {{ cart_count_offset_x }}px;
    --yh-cart-count-offset-y: {{ cart_count_offset_y }}px;
    --yh-country-bg: {{ country_selector_background }};
    --yh-country-border: {{ country_selector_border }};
    --yh-country-text: {{ country_selector_text }};
    --yh-country-height: {{ country_selector_height }}px;
  "
  {{ section.shopify_attributes }}
>
  {%- capture logo_markup -%}
    <a href="{{ routes.root_url }}" class="yaomri-header__logo-link" aria-label="{{ shop.name | escape }}">
      {%- if desktop_logo != blank -%}
        {{
          desktop_logo
          | image_url: width: 800
          | image_tag:
            class: 'yaomri-header__logo-image',
            widths: '120, 160, 200, 240, 300, 360, 420, 520, 680, 800',
            sizes: '(min-width: 990px) var(--yh-desktop-logo-width), var(--yh-mobile-logo-width)',
            loading: 'eager',
            alt: desktop_logo.alt | default: shop.name | escape
        }}
      {%- else -%}
        <span class="yaomri-header__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  {%- endcapture -%}

  {%- capture mobile_logo_markup -%}
    <a href="{{ routes.root_url }}" class="yaomri-header__logo-link yaomri-header__logo-link--mobile" aria-label="{{ shop.name | escape }}">
      {%- if mobile_logo != blank -%}
        {{
          mobile_logo
          | image_url: width: 640
          | image_tag:
            class: 'yaomri-header__logo-image',
            widths: '100, 140, 180, 220, 280, 360, 480, 640',
            sizes: '(max-width: 989px) var(--yh-mobile-logo-width), var(--yh-desktop-logo-width)',
            loading: 'eager',
            alt: mobile_logo.alt | default: shop.name | escape
        }}
      {%- else -%}
        <span class="yaomri-header__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  {%- endcapture -%}

  {%- capture nav_markup -%}
    {% render 'mega-menu', section: section, fallback_menu: navigation_menu %}
  {%- endcapture -%}

  {%- capture actions_markup -%}
    <div class="yaomri-header__actions">
      <a class="yaomri-header__icon" href="{{ routes.search_url }}" aria-label="Search">
        {% render 'icon-yaomri-search' %}
      </a>

      {%- if show_country_selector and localization.available_countries.size > 1 -%}
        {%- form 'localization', id: 'HeaderCountryForm', class: country_selector_class -%}
          <span class="yaomri-header__country-current" aria-hidden="true">
            {{ current_country_label }}
          </span>
          <select
            id="HeaderCountrySelector"
            class="yaomri-header__country-select"
            name="country_code"
            aria-label="Country/region"
            onchange="this.form.submit()"
          >
            {%- for country in localization.available_countries -%}
              {%- capture country_flag -%}
                {%- if country_selector_show_flag -%}
                  {%- render 'country-flag', iso_code: country.iso_code -%}
                {%- endif -%}
              {%- endcapture -%}
              {%- assign country_flag = country_flag | strip -%}
              {%- assign option_country_name = country.name | default: country.iso_code -%}
              {%- capture country_label -%}
                {%- if country_flag != blank -%}{{ country_flag }} {% endif -%}
                {%- if country_selector_style == 'full' -%}
                  {{- option_country_name -}}
                {%- else -%}
                  {{- country.iso_code -}}
                {%- endif -%}
                {%- if country_selector_show_currency -%} / {{ country.currency.iso_code }}{%- endif -%}
              {%- endcapture -%}
              <option
                value="{{ country.iso_code }}"
                {%- if country.iso_code == localization.country.iso_code -%} selected{%- endif -%}
              >
                {{ country_label | strip }}
              </option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}

      {%- if show_account_icon and shop.customer_accounts_enabled -%}
        <a class="yaomri-header__icon" href="{{ routes.account_url }}" aria-label="Account">
          {% render 'icon-yaomri-account' %}
        </a>
      {%- endif -%}

      {%- if show_wishlist_icon -%}
        <a class="yaomri-header__icon" href="{{ wishlist_url }}" aria-label="Wishlist">
          {% render 'icon-yaomri-heart' %}
        </a>
      {%- endif -%}

      {%- if show_cart_icon -%}
        <a class="yaomri-header__icon yaomri-header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
          {% render 'icon-yaomri-cart' %}
          {%- if cart.item_count > 0 -%}
            <span id="cart-icon-bubble" class="yaomri-header__cart-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  {%- endcapture -%}

  <div class="yaomri-header__desktop">
    <div class="yaomri-header__desktop-left">
      {%- if resolved_layout == 'logo_left_nav_center_actions_right' -%}
        {{ logo_markup }}
      {%- elsif resolved_layout == 'nav_left_logo_center_actions_right' -%}
        {{ nav_markup }}
      {%- endif -%}
    </div>

    <div class="yaomri-header__desktop-centre">
      {%- if resolved_layout == 'logo_left_nav_center_actions_right' -%}
        {{ nav_markup }}
      {%- else -%}
        {{ logo_markup }}
      {%- endif -%}
    </div>

    <div class="yaomri-header__desktop-right">
      {{ actions_markup }}
    </div>
  </div>

  <div class="yaomri-header__mobile">
    <div class="yaomri-header__mobile-left">
      <button
        class="yaomri-header__icon"
        type="button"
        data-mdrawer-trigger
        aria-label="Open menu"
      >
        {% render 'icon-yaomri-menu' %}
      </button>
    </div>

    <div class="yaomri-header__mobile-center">
      {{ mobile_logo_markup }}
    </div>

    <div class="yaomri-header__mobile-right">
      <a class="yaomri-header__icon" href="{{ routes.search_url }}" aria-label="Search">
        {% render 'icon-yaomri-search' %}
      </a>

      {%- if show_wishlist_icon -%}
        <a class="yaomri-header__icon yaomri-header__mobile-optional" href="{{ wishlist_url }}" aria-label="Wishlist">
          {% render 'icon-yaomri-heart' %}
        </a>
      {%- endif -%}

      {%- if show_cart_icon -%}
        <a class="yaomri-header__icon yaomri-header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
          {% render 'icon-yaomri-cart' %}
          {%- if cart.item_count > 0 -%}
            <span class="yaomri-header__cart-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ya Omri header",
  "settings": [
    {
      "type": "paragraph",
      "content": "Header style settings are managed in Theme settings > Header."
    },
    {
      "type": "paragraph",
      "content": "Mobile drawer settings are in the Mobile Menu section."
    }
  ],
  "max_blocks": 30,
  "blocks": [
    {
      "type": "base_item",
      "name": "Simple link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Navigation label",
          "info": "Used for a normal top-level navigation link.",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "highlight_item",
          "label": "Highlight item",
          "default": false
        },
        {
          "type": "color",
          "id": "highlight_color",
          "label": "Highlight colour",
          "default": "#c0392b"
        },
        {
          "type": "text",
          "id": "label_text",
          "label": "Badge text"
        },
        {
          "type": "color",
          "id": "label_color",
          "label": "Badge colour",
          "default": "#111111"
        }
      ]
    },
    {
      "type": "dropdown_item",
      "name": "Dropdown link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Navigation label",
          "info": "Used for a top-level navigation link with a compact dropdown menu.",
          "default": "Dropdown"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Dropdown menu"
        },
        {
          "type": "select",
          "id": "dropdown_position",
          "label": "Dropdown position",
          "default": "start",
          "options": [
            {
              "value": "start",
              "label": "Start"
            },
            {
              "value": "center",
              "label": "Centre"
            },
            {
              "value": "end",
              "label": "End"
            }
          ]
        },
        {
          "type": "range",
          "id": "dropdown_width",
          "label": "Dropdown panel width",
          "info": "Controls this dropdown panel box width on desktop only.",
          "min": 180,
          "max": 520,
          "step": 10,
          "unit": "px",
          "default": 260
        },
        {
          "type": "checkbox",
          "id": "highlight_item",
          "label": "Highlight item",
          "default": false
        },
        {
          "type": "color",
          "id": "highlight_color",
          "label": "Highlight colour",
          "default": "#c0392b"
        },
        {
          "type": "text",
          "id": "label_text",
          "label": "Badge text"
        },
        {
          "type": "color",
          "id": "label_color",
          "label": "Badge colour",
          "default": "#111111"
        }
      ]
    },
    {
      "type": "mega_item",
      "name": "Mega menu link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Navigation label",
          "info": "Used for a top-level link that opens a panel from the Mega menu section.",
          "default": "Mega"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link",
          "info": "Used if the mega panel cannot open."
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Open fallback link in new tab",
          "default": false
        },
        {
          "type": "text",
          "id": "mega_menu_id",
          "label": "Mega panel ID to open",
          "info": "This must match a Panel ID in the Mega menu section.",
          "default": "1"
        },
        {
          "type": "checkbox",
          "id": "highlight_item",
          "label": "Highlight item",
          "default": false
        },
        {
          "type": "color",
          "id": "highlight_color",
          "label": "Highlight colour",
          "default": "#c0392b"
        },
        {
          "type": "text",
          "id": "label_text",
          "label": "Badge text"
        },
        {
          "type": "color",
          "id": "label_color",
          "label": "Badge colour",
          "default": "#111111"
        }
      ]
    }
  ]
}
{% endschema %}
