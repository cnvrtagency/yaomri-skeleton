      "min": 14,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "cart_count_text_size",
      "label": "Cart count text size",
      "min": 9,
      "max": 14,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "cart_count_offset_x",
      "label": "Cart count horizontal offset",
      "min": -12,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "cart_count_offset_y",
      "label": "Cart count vertical offset",
      "min": -12,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": -4
    },
    {
      "type": "header",
      "content": "Region chip"
    },
    {
      "type": "checkbox",
      "id": "show_region_chip",
      "label": "Show region chip",
      "default": true
    },
    {
      "type": "text",
      "id": "region_flag",
      "label": "Region flag",
      "default": "🇦🇪"
    },
    {
      "type": "text",
      "id": "region_label",
      "label": "Region label",
      "default": "AE"
    },
    {
      "type": "text",
      "id": "region_currency",
      "label": "Region currency",
      "default": "AED"
    },
    {
      "type": "url",
      "id": "region_link",
      "label": "Region link"
    },
    {
      "type": "color",
      "id": "region_chip_background",
      "label": "Region chip background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "region_chip_border",
      "label": "Region chip border",
      "default": "#e8e8e8"
    },
    {
      "type": "color",
      "id": "region_chip_text",
      "label": "Region chip text",
