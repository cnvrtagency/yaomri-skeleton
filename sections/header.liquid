      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "icon_button_size_mobile",
      "label": "Icon button size mobile",
      "min": 34,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
