{{ 'yaomri-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign raw_layout = section.settings.desktop_layout
  assign resolved_layout = raw_layout

  case raw_layout
    when 'search_left_logo_center_actions_right'
      assign resolved_layout = 'search_left_logo_center_icons_right'
    when 'logo_left_search_center_actions_right'
      assign resolved_layout = 'logo_left_search_center_icons_right'
    when 'logo_left_search_right'
      assign resolved_layout = 'logo_left_search_center_icons_right'
    when 'logo_center_actions_right'
      assign resolved_layout = 'search_left_logo_center_icons_right'
    when 'logo_left_nav_center_actions_right'
      assign resolved_layout = 'logo_left_nav_center_search_icons_right'
  endcase

  assign has_menu = false
  if section.settings.menu != blank and linklists[section.settings.menu] != blank and linklists[section.settings.menu].links.size > 0
    assign has_menu = true
  endif

  assign nav_below_desktop = false
  if has_menu and resolved_layout == 'search_left_logo_center_icons_right' or has_menu and resolved_layout == 'logo_left_search_center_icons_right'
    assign nav_below_desktop = true
  endif

  assign wishlist_url = section.settings.wishlist_link | default: '/pages/wishlist'
  assign region_label = section.settings.region_label | default: section.settings.country_label
  assign region_flag = section.settings.region_flag
  assign region_currency = section.settings.region_currency
  assign desktop_logo = settings.logo
  assign mobile_logo = settings.mobile_logo | default: settings.logo
-%}

<section
  class="yaomri-header{% if section.settings.enable_sticky %} yaomri-header--sticky{% endif %}{% unless section.settings.show_bottom_border %} yaomri-header--no-border{% endunless %}"
  style="
    --yh-bg: {{ section.settings.header_background }};
    --yh-fg: {{ section.settings.header_foreground }};
    --yh-border: {{ section.settings.header_border }};
    --yh-max-width: {{ section.settings.header_max_width }}px;
    --yh-desktop-padding: {{ section.settings.desktop_side_padding }}px;
    --yh-mobile-padding: {{ section.settings.mobile_side_padding }}px;
    --yh-desktop-height: {{ section.settings.desktop_header_height }}px;
    --yh-mobile-height: {{ section.settings.mobile_header_height }}px;
    --yh-desktop-logo-width: {{ section.settings.desktop_logo_width }}px;
    --yh-mobile-logo-width: {{ section.settings.mobile_logo_width }}px;
    --yh-desktop-logo-max-height: {{ section.settings.desktop_logo_max_height }}px;
    --yh-mobile-logo-max-height: {{ section.settings.mobile_logo_max_height }}px;
    --yh-logo-offset-desktop: {{ section.settings.desktop_logo_offset_y }}px;
    --yh-logo-offset-mobile: {{ section.settings.mobile_logo_offset_y }}px;
    --yh-search-width: {{ section.settings.search_width_desktop }}px;
    --yh-search-height: {{ section.settings.search_height_desktop }}px;
    --yh-search-bg: {{ section.settings.search_background }};
    --yh-search-text: {{ section.settings.search_text_color }};
    --yh-icon-size: {{ section.settings.icon_size }}px;
    --yh-icon-button-desktop: {{ section.settings.icon_button_size_desktop }}px;
    --yh-icon-button-mobile: {{ section.settings.icon_button_size_mobile }}px;
    --yh-desktop-icon-gap: {{ section.settings.desktop_icon_gap }}px;
    --yh-mobile-icon-gap: {{ section.settings.mobile_icon_gap }}px;
    --yh-nav-size: {{ section.settings.nav_text_size }}px;
    --yh-nav-gap: {{ section.settings.nav_gap }}px;
    --yh-cart-count-bg: {{ section.settings.cart_count_background }};
    --yh-cart-count-text: {{ section.settings.cart_count_text }};
    --yh-cart-count-size: {{ section.settings.cart_count_size }}px;
    --yh-cart-count-font-size: {{ section.settings.cart_count_text_size }}px;
    --yh-cart-count-offset-x: {{ section.settings.cart_count_offset_x }}px;
    --yh-cart-count-offset-y: {{ section.settings.cart_count_offset_y }}px;
    --yh-region-bg: {{ section.settings.region_chip_background }};
    --yh-region-border: {{ section.settings.region_chip_border }};
    --yh-region-text: {{ section.settings.region_chip_text }};
    --yh-region-height: {{ section.settings.region_chip_height }}px;
    --yh-mobile-drawer-width: {{ section.settings.mobile_drawer_width }}px;
    --yh-mobile-drawer-bg: {{ section.settings.mobile_drawer_background }};
    --yh-mobile-drawer-text: {{ section.settings.mobile_drawer_text }};
  "
  {{ section.shopify_attributes }}
>
  {%- capture logo_markup -%}
    <a href="{{ routes.root_url }}" class="yaomri-header__logo-link" aria-label="{{ shop.name | escape }}">
      {%- if desktop_logo != blank -%}
        {{
          desktop_logo
          | image_url: width: 800
          | image_tag:
            class: 'yaomri-header__logo-image',
            widths: '120, 160, 200, 240, 300, 360, 420, 520, 680, 800',
            sizes: '(min-width: 990px) var(--yh-desktop-logo-width), var(--yh-mobile-logo-width)',
            loading: 'eager',
            alt: desktop_logo.alt | default: shop.name | escape
        }}
      {%- else -%}
        <span class="yaomri-header__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  {%- endcapture -%}

  {%- capture mobile_logo_markup -%}
    <a href="{{ routes.root_url }}" class="yaomri-header__logo-link yaomri-header__logo-link--mobile" aria-label="{{ shop.name | escape }}">
      {%- if mobile_logo != blank -%}
        {{
          mobile_logo
          | image_url: width: 640
          | image_tag:
            class: 'yaomri-header__logo-image',
            widths: '100, 140, 180, 220, 280, 360, 480, 640',
            sizes: '(max-width: 989px) var(--yh-mobile-logo-width), var(--yh-desktop-logo-width)',
            loading: 'eager',
            alt: mobile_logo.alt | default: shop.name | escape
        }}
      {%- else -%}
        <span class="yaomri-header__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  {%- endcapture -%}

  {%- capture search_field_markup -%}
    {%- if section.settings.show_desktop_search -%}
      <form class="yaomri-header__search{% if section.settings.search_icon_position == 'right' %} yaomri-header__search--right{% endif %}" action="{{ routes.search_url }}" method="get" role="search">
        <span class="yaomri-header__search-icon" aria-hidden="true">{% render 'icon-yaomri-search' %}</span>
        <input
          class="yaomri-header__search-input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          autocorrect="off"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <input type="hidden" name="options[prefix]" value="last">
      </form>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture compact_search_markup -%}
    {%- if section.settings.show_desktop_search -%}
      <a class="yaomri-header__icon" href="{{ routes.search_url }}" aria-label="Search">
        {% render 'icon-yaomri-search' %}
      </a>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture nav_markup -%}
    {%- if has_menu -%}
      <nav class="yaomri-header__nav" aria-label="Primary">
        {%- for link in linklists[section.settings.menu].links -%}
          <a class="yaomri-header__nav-link" href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture actions_markup -%}
    <div class="yaomri-header__actions">
      {%- if section.settings.show_region_chip -%}
        {%- capture region_text -%}
          {%- if region_flag != blank -%}<span class="yaomri-header__region-flag">{{ region_flag }}</span>{%- endif -%}
          {%- if region_label != blank -%}<span>{{ region_label }}</span>{%- endif -%}
          {%- if region_currency != blank -%}<span>/ {{ region_currency }}</span>{%- endif -%}
        {%- endcapture -%}
        {%- if section.settings.region_link != blank -%}
          <a class="yaomri-header__region" href="{{ section.settings.region_link }}">{{ region_text }}</a>
        {%- else -%}
          <span class="yaomri-header__region">{{ region_text }}</span>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_account_icon and shop.customer_accounts_enabled -%}
        <a class="yaomri-header__icon" href="{{ routes.account_url }}" aria-label="Account">
          {% render 'icon-yaomri-account' %}
        </a>
      {%- endif -%}

      {%- if section.settings.show_wishlist_icon -%}
        <a class="yaomri-header__icon" href="{{ wishlist_url }}" aria-label="Wishlist">
          {% render 'icon-yaomri-heart' %}
        </a>
      {%- endif -%}

      {%- if section.settings.show_cart_icon -%}
        <a class="yaomri-header__icon yaomri-header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
          {% render 'icon-yaomri-cart' %}
          {%- if cart.item_count > 0 -%}
            <span id="cart-icon-bubble" class="yaomri-header__cart-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  {%- endcapture -%}

  <div class="yaomri-header__desktop yaomri-header__desktop--{{ resolved_layout }}">
    <div class="yaomri-header__desktop-left">
      {%- case resolved_layout -%}
        {%- when 'logo_left_nav_center_search_icons_right' -%}
          {{ logo_markup }}
        {%- when 'search_left_logo_center_icons_right' -%}
          {{ search_field_markup }}
        {%- when 'logo_left_search_center_icons_right' -%}
          {{ logo_markup }}
        {%- when 'nav_left_logo_center_icons_right' -%}
          {{ nav_markup }}
      {%- endcase -%}
    </div>

    <div class="yaomri-header__desktop-centre">
      {%- case resolved_layout -%}
        {%- when 'logo_left_nav_center_search_icons_right' -%}
          {{ nav_markup }}
        {%- when 'search_left_logo_center_icons_right' -%}
          {{ logo_markup }}
        {%- when 'logo_left_search_center_icons_right' -%}
          {{ search_field_markup }}
        {%- when 'nav_left_logo_center_icons_right' -%}
          {{ logo_markup }}
      {%- endcase -%}
    </div>

    <div class="yaomri-header__desktop-right">
      {%- case resolved_layout -%}
        {%- when 'logo_left_nav_center_search_icons_right' -%}
          <div class="yaomri-header__desktop-right-stack">
            {{ search_field_markup }}
            {{ actions_markup }}
          </div>
        {%- when 'search_left_logo_center_icons_right' -%}
          {{ actions_markup }}
        {%- when 'logo_left_search_center_icons_right' -%}
          {{ actions_markup }}
        {%- when 'nav_left_logo_center_icons_right' -%}
          <div class="yaomri-header__desktop-right-stack">
            {{ compact_search_markup }}
            {{ actions_markup }}
          </div>
      {%- endcase -%}
    </div>
  </div>

  {%- if nav_below_desktop -%}
    <div class="yaomri-header__desktop-nav-row">
      {{ nav_markup }}
    </div>
  {%- endif -%}

  <div class="yaomri-header__mobile">
    <div class="yaomri-header__mobile-left">
      <details class="yaomri-header__drawer">
        <summary class="yaomri-header__icon" aria-label="{{ section.settings.mobile_menu_label | escape }}">
          <span class="yaomri-header__drawer-open">{% render 'icon-yaomri-menu' %}</span>
          <span class="yaomri-header__drawer-close">{% render 'icon-yaomri-close' %}</span>
        </summary>
        {%- if has_menu -%}
          <div class="yaomri-header__drawer-panel">
            <nav class="yaomri-header__drawer-nav" aria-label="Mobile">
              {%- for link in linklists[section.settings.menu].links -%}
                <a class="yaomri-header__drawer-link" href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            </nav>
          </div>
        {%- endif -%}
      </details>
    </div>

    <div class="yaomri-header__mobile-center">
      {{ mobile_logo_markup }}
    </div>

    <div class="yaomri-header__mobile-right">
      {%- if section.settings.show_mobile_search -%}
        <a class="yaomri-header__icon" href="{{ routes.search_url }}" aria-label="Search">
          {% render 'icon-yaomri-search' %}
        </a>
      {%- endif -%}

      {%- if section.settings.show_wishlist_icon -%}
        <a class="yaomri-header__icon yaomri-header__mobile-optional" href="{{ wishlist_url }}" aria-label="Wishlist">
          {% render 'icon-yaomri-heart' %}
        </a>
      {%- endif -%}

      {%- if section.settings.show_cart_icon -%}
        <a class="yaomri-header__icon yaomri-header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
          {% render 'icon-yaomri-cart' %}
          {%- if cart.item_count > 0 -%}
            <span class="yaomri-header__cart-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ya Omri header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "range",
      "id": "desktop_logo_width",
      "label": "Desktop logo width",
      "min": 60,
      "max": 320,
      "step": 5,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile logo width",
      "min": 50,
      "max": 220,
      "step": 5,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "desktop_logo_max_height",
      "label": "Logo max height desktop",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "mobile_logo_max_height",
      "label": "Logo max height mobile",
      "min": 24,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 58
    },
    {
      "type": "range",
      "id": "desktop_logo_offset_y",
      "label": "Desktop logo offset",
      "min": -20,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_logo_offset_y",
      "label": "Mobile logo offset",
      "min": -20,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Header layout"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "default": "logo_left_nav_center_search_icons_right",
      "options": [
        {
          "value": "logo_left_nav_center_search_icons_right",
          "label": "Logo left, nav centre, search and icons right"
        },
        {
          "value": "search_left_logo_center_icons_right",
          "label": "Search left, logo centre"
        },
        {
          "value": "logo_left_search_center_icons_right",
          "label": "Logo left, search centre"
        },
        {
          "value": "nav_left_logo_center_icons_right",
          "label": "Logo centre, nav left, icons right"
        }
      ]
    },
    {
      "type": "range",
      "id": "header_max_width",
      "label": "Header max width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1500
    },
    {
      "type": "range",
      "id": "desktop_side_padding",
      "label": "Desktop side padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "label": "Mobile side padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_header_height",
      "label": "Desktop header height",
      "min": 56,
      "max": 130,
      "step": 2,
      "unit": "px",
      "default": 82
    },
    {
      "type": "range",
      "id": "mobile_header_height",
      "label": "Mobile header height",
      "min": 52,
      "max": 110,
      "step": 2,
      "unit": "px",
      "default": 74
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Header background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_foreground",
      "label": "Header text and icon",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "header_border",
      "label": "Header border",
      "default": "#e8e8e8"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_desktop_search",
      "label": "Show desktop search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile_search",
      "label": "Show mobile search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search"
    },
    {
      "type": "range",
      "id": "search_width_desktop",
      "label": "Search width desktop",
      "min": 180,
      "max": 520,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "search_height_desktop",
      "label": "Search height desktop",
      "min": 42,
      "max": 86,
      "step": 2,
      "unit": "px",
      "default": 58
    },
    {
      "type": "color",
      "id": "search_background",
      "label": "Search background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "search_text_color",
      "label": "Search text color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "search_icon_position",
      "label": "Search icon position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Icons"
