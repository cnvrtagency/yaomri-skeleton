      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_icon",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Wishlist"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist_icon",
      "label": "Show wishlist icon",
      "default": true
    },
    {
      "type": "url",
      "id": "wishlist_link",
      "label": "Wishlist link"
    },
    {
      "type": "header",
      "content": "Cart count"
    },
    {
      "type": "color",
      "id": "cart_count_background",
      "label": "Cart count background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "cart_count_text",
      "label": "Cart count text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "cart_count_size",
