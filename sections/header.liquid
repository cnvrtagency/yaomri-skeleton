    },
    {
      "type": "text",
      "id": "region_currency",
      "label": "Region currency",
      "default": "AED"
    },
    {
      "type": "url",
      "id": "region_link",
      "label": "Region link"
    },
    {
      "type": "color",
      "id": "region_chip_background",
      "label": "Region chip background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "region_chip_border",
      "label": "Region chip border",
      "default": "#e8e8e8"
    },
    {
      "type": "color",
      "id": "region_chip_text",
      "label": "Region chip text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "region_chip_height",
      "label": "Region chip height",
      "min": 34,
      "max": 64,
      "step": 2,
      "unit": "px",
