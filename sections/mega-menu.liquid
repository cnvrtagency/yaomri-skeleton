{%- liquid
  assign panel_background = section.settings.mega_panel_background
  if panel_background == blank
    assign panel_background = 'var(--color-background)'
  endif
  assign panel_text = section.settings.mega_panel_text
  if panel_text == blank
    assign panel_text = 'var(--color-foreground)'
  endif
  assign panel_border = section.settings.mega_panel_border
  if panel_border == blank
    assign panel_border = 'var(--color-border)'
  endif
  assign panel_shadow = section.settings.mega_panel_shadow | default: 'subtle'
  assign panel_shadow_value = '0 18px 34px rgba(10, 10, 10, 0.08)'
  case panel_shadow
    when 'none'
      assign panel_shadow_value = 'none'
    when 'medium'
      assign panel_shadow_value = '0 26px 44px rgba(10, 10, 10, 0.1)'
    when 'strong'
      assign panel_shadow_value = '0 34px 64px rgba(10, 10, 10, 0.16)'
  endcase
  assign panel_style_preset = section.settings.panel_style_preset | default: 'minimal'
  assign heading_style = section.settings.heading_style | default: 'bold'
-%}

<div class="yaomri-mega-section cnvrt-mega-section" data-mega-section>
  <div
    class="yaomri-mega-panels cnvrt-mega-panels yaomri-mega-panels--style-{{ panel_style_preset }} cnvrt-mega-panels--style-{{ panel_style_preset }} yaomri-mega-panels--heading-{{ heading_style }} cnvrt-mega-panels--heading-{{ heading_style }}"
    data-mega-panels
    data-panel-width="{{ section.settings.mega_panel_width | default: 1200 }}"
    data-close-delay="{{ section.settings.close_delay | default: 250 }}"
    style="
      --cnvrt-mega-panel-width: {{ section.settings.mega_panel_width | default: 1200 }}px;
      --cnvrt-mega-panel-bg: {{ panel_background }};
      --cnvrt-mega-panel-text: {{ panel_text }};
      --cnvrt-mega-panel-border: {{ panel_border }};
      --cnvrt-mega-panel-shadow: {{ panel_shadow_value }};
      --cnvrt-mega-panel-gap-y: var(--ym-panel-gap-y, 1.25rem);
      --cnvrt-mega-panel-gap-x: var(--ym-panel-gap-x, 1.25rem);
      --cnvrt-mega-panel-padding-y: var(--ym-panel-padding-y, 1.5rem);
      --cnvrt-mega-panel-padding-bottom: var(--ym-panel-padding-bottom, 2rem);
      --cnvrt-mega-panel-top: var(--ym-panel-top, 0px);
      --ym-panel-top: var(--cnvrt-mega-panel-top);
      --ym-panel-width: var(--cnvrt-mega-panel-width);
      --ym-panel-bg: var(--cnvrt-mega-panel-bg);
      --ym-panel-text: var(--cnvrt-mega-panel-text);
      --ym-panel-border: var(--cnvrt-mega-panel-border);
      --ym-panel-shadow: var(--cnvrt-mega-panel-shadow);
      --ym-panel-gap-y: var(--cnvrt-mega-panel-gap-y);
      --ym-panel-gap-x: var(--cnvrt-mega-panel-gap-x);
      --ym-panel-padding-y: var(--cnvrt-mega-panel-padding-y);
      --ym-panel-padding-bottom: var(--cnvrt-mega-panel-padding-bottom);
    "
    aria-hidden="true"
  >
    <button
      class="yaomri-mega-panels__backdrop cnvrt-mega-panels__backdrop"
      type="button"
      data-mega-close
      aria-label="Close menu"
    ></button>
    {%- for block in section.blocks -%}
      {%- if block.type == 'mega_parent' -%}
        {% render 'mega-menu-panel', parent_block: block, all_blocks: section.blocks, panel_width: section.settings.mega_panel_width %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Mega menu",
  "max_blocks": 50,
  "settings": [
    {
      "type": "range",
      "id": "mega_panel_width",
      "label": "Mega panel width",
      "info": "Controls the visible mega menu panel width on desktop.",
      "min": 400,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "select",
      "id": "panel_style_preset",
      "label": "Panel style",
      "default": "minimal",
      "options": [
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "compact",
          "label": "Compact"
        }
      ]
    },
    {
      "type": "color",
      "id": "mega_panel_background",
      "label": "Mega panel background"
    },
    {
      "type": "color",
      "id": "mega_panel_text",
      "label": "Mega panel text colour"
    },
    {
      "type": "color",
      "id": "mega_panel_border",
      "label": "Mega panel border colour"
    },
    {
      "type": "select",
      "id": "mega_panel_shadow",
      "label": "Mega panel shadow",
      "default": "subtle",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "strong",
          "label": "Strong"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Link column heading style",
      "default": "bold",
      "options": [
        {
          "value": "understated",
          "label": "Understated"
        },
        {
          "value": "bold",
          "label": "Bold"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        }
      ]
    },
    {
      "type": "range",
      "id": "close_delay",
      "label": "Hover close delay",
      "info": "Time before the mega menu closes after the cursor leaves.",
      "min": 100,
      "max": 800,
      "step": 50,
      "unit": "ms",
      "default": 250
    }
  ],
  "blocks": [
    {
      "type": "mega_parent",
      "name": "Mega panel",
      "settings": [
        {
          "type": "text",
          "id": "parent_id",
          "label": "Panel ID",
          "info": "Must match the Mega panel ID to open in a Header mega menu link.",
          "default": "1"
        },
        {
          "type": "checkbox",
          "id": "enable_packery",
          "label": "Flexible layout",
          "info": "On: mixed-width blocks flow together. Off: blocks stay in stricter rows.",
          "default": true
        }
      ]
    },
    {
      "type": "linklist_child",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "parent_id",
          "label": "Show in panel ID",
          "info": "This must match a Panel ID from a Mega panel block.",
          "default": "1"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "url",
          "id": "heading_link",
          "label": "Heading link"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Link column menu"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Open heading link in new tab",
          "default": false
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Link text size",
          "min": 11,
          "max": 18,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "range",
          "id": "space_between",
          "label": "Link spacing",
          "min": 6,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 10
        },
        {
          "type": "select",
          "id": "column_width",
          "label": "Column width",
          "default": "25",
          "options": [
            { "value": "20", "label": "20%" },
            { "value": "25", "label": "25%" },
            { "value": "33", "label": "33%" },
            { "value": "50", "label": "50%" },
            { "value": "66", "label": "66%" },
            { "value": "75", "label": "75%" },
            { "value": "100", "label": "100%" }
          ]
        }
      ]
    },
    {
      "type": "image_tile_child",
      "name": "Image tile",
      "settings": [
        {
          "type": "text",
          "id": "parent_id",
          "label": "Show in panel ID",
          "info": "This must match a Panel ID from a Mega panel block.",
          "default": "1"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "column_width",
          "label": "Tile width",
          "default": "25",
          "options": [
            { "value": "20", "label": "20%" },
            { "value": "25", "label": "25%" },
            { "value": "33", "label": "33%" },
            { "value": "50", "label": "50%" },
            { "value": "66", "label": "66%" },
            { "value": "75", "label": "75%" },
            { "value": "100", "label": "100%" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mega menu"
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
