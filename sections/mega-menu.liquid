<div class="yaomri-mega-section" data-mega-section>
  <div class="yaomri-mega-panels" data-mega-panels aria-hidden="true">
    <button class="yaomri-mega-panels__backdrop" type="button" data-mega-close aria-label="Close menu"></button>
    {%- for block in section.blocks -%}
      {%- if block.type == 'mega_parent' -%}
        {% render 'mega-menu-panel', parent_block: block, all_blocks: section.blocks %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Mega menu",
  "max_blocks": 50,
  "settings": [],
  "blocks": [
    {
      "type": "mega_parent",
      "name": "Mega menu parent",
      "settings": [
        {
          "type": "text",
          "id": "parent_id",
          "label": "ID",
          "default": "1"
        },
        {
          "type": "text",
          "id": "admin_label",
          "label": "Admin label"
        },
        {
          "type": "checkbox",
          "id": "enable_packery",
          "label": "Enable packery layout",
          "default": true
        }
      ]
    },
    {
      "type": "linklist_child",
      "name": "Linklist child",
      "settings": [
        {
          "type": "text",
          "id": "parent_id",
          "label": "Parent ID",
          "default": "1"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "url",
          "id": "heading_link",
          "label": "Heading link"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Open link in new window",
          "default": false
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Font size",
          "min": 11,
          "max": 18,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "range",
          "id": "space_between",
          "label": "Space between menu items",
          "min": 6,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 10
        },
        {
          "type": "select",
          "id": "column_width",
          "label": "Column width",
          "default": "25",
          "options": [
            { "value": "20", "label": "20%" },
            { "value": "25", "label": "25%" },
            { "value": "33", "label": "33%" },
            { "value": "50", "label": "50%" },
            { "value": "66", "label": "66%" },
            { "value": "75", "label": "75%" },
            { "value": "100", "label": "100%" }
          ]
        }
      ]
    },
    {
      "type": "image_tile_child",
      "name": "Image tile child",
      "settings": [
        {
          "type": "text",
          "id": "parent_id",
          "label": "Parent ID",
          "default": "1"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "CTA text"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "column_width",
          "label": "Column width",
          "default": "25",
          "options": [
            { "value": "20", "label": "20%" },
            { "value": "25", "label": "25%" },
            { "value": "33", "label": "33%" },
            { "value": "50", "label": "50%" },
            { "value": "66", "label": "66%" },
            { "value": "75", "label": "75%" },
            { "value": "100", "label": "100%" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mega menu"
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
