{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'announcement-bar.js' | asset_url }}" defer></script>

{%- liquid
  assign is_enabled = section.settings.enable_announcement_bar
  assign mode = section.settings.mode | default: 'static'
  assign width_mode = section.settings.bar_width | default: 'full'
  assign custom_width = section.settings.custom_width | default: 1200
  assign show_bottom_border = section.settings.show_bottom_border
  assign autoplay = section.settings.carousel_autoplay
  assign autoplay_speed = section.settings.carousel_speed | default: 4 | times: 1000
  assign show_arrows = section.settings.carousel_show_arrows
  assign show_dots = section.settings.carousel_show_dots
  assign marquee_speed = section.settings.marquee_speed | default: 28
  assign marquee_pause_on_hover = section.settings.marquee_pause_on_hover
-%}

{%- if is_enabled or request.design_mode -%}
<section
  class="yaomri-announcement full-width yaomri-announcement--mode-{{ mode }} yaomri-announcement--width-{{ width_mode }}{% if show_bottom_border %} yaomri-announcement--with-border{% endif %}{% if marquee_pause_on_hover %} yaomri-announcement--marquee-pause{% endif %}"
  style="
    --yab-custom-width: {{ custom_width }}px;
    --yab-bg: {{ section.settings.background_color }};
    --yab-text: {{ section.settings.text_color }};
    --yab-border: {{ section.settings.border_color }};
    --yab-height-desktop: {{ section.settings.height_desktop }}px;
    --yab-height-mobile: {{ section.settings.height_mobile }}px;
    --yab-pad-inline-desktop: {{ section.settings.desktop_padding_inline }}px;
    --yab-pad-inline-mobile: {{ section.settings.mobile_padding_inline }}px;
    --yab-pad-block-desktop: {{ section.settings.desktop_padding_block }}px;
    --yab-pad-block-mobile: {{ section.settings.mobile_padding_block }}px;
    --yab-font-size-desktop: {{ section.settings.font_size_desktop }}px;
    --yab-font-size-mobile: {{ section.settings.font_size_mobile }}px;
    --yab-font-weight: {{ section.settings.font_weight }};
    --yab-letter-spacing: {{ section.settings.letter_spacing | divided_by: 100.0 }}em;
    --yab-text-transform: {{ section.settings.text_transform }};
    --yab-item-gap: {{ section.settings.item_gap }}px;
    --yab-marquee-duration: {{ marquee_speed }}s;
  "
  {{ section.shopify_attributes }}
>
  <div class="yaomri-announcement__inner">
    {%- liquid
      assign valid_block_count = 0
      for block in section.blocks
        if block.settings.text != blank
          assign valid_block_count = valid_block_count | plus: 1
        endif
      endfor
    -%}

    {%- if valid_block_count == 0 -%}
      {%- if request.design_mode -%}
        <div class="yaomri-announcement__placeholder">Add announcement blocks</div>
      {%- endif -%}
    {%- elsif mode == 'static' -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          <div class="yaomri-announcement__item{% if block.settings.hide_on_mobile %} yaomri-announcement__item--hide-mobile{% endif %}{% if block.settings.hide_on_desktop %} yaomri-announcement__item--hide-desktop{% endif %}" {{ block.shopify_attributes }}>
            {%- liquid
              assign prefix = block.settings.prefix
              assign label = block.settings.text
              if block.settings.link != blank
                echo '<a class="yaomri-announcement__link" href="'
                echo block.settings.link
                echo '"'
                if block.settings.open_new_window
                  echo ' target="_blank" rel="noopener noreferrer"'
                endif
                echo '>'
                if prefix != blank
                  echo '<span class="yaomri-announcement__prefix">'
                  echo prefix | escape
                  echo '</span>'
                endif
                echo '<span class="yaomri-announcement__text">'
                echo label
                echo '</span></a>'
              else
                if prefix != blank
                  echo '<span class="yaomri-announcement__prefix">'
                  echo prefix | escape
                  echo '</span>'
                endif
                echo '<span class="yaomri-announcement__text">'
                echo label
                echo '</span>'
              endif
            -%}
          </div>
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- elsif mode == 'carousel' -%}
      <div
        class="yaomri-announcement__carousel"
        data-announcement-carousel
        data-autoplay="{% if autoplay %}true{% else %}false{% endif %}"
        data-speed="{{ autoplay_speed }}"
      >
        <div class="yaomri-announcement__slides" data-announcement-slides>
          {%- assign slide_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <div
                class="yaomri-announcement__slide{% if slide_index == 0 %} is-active{% endif %}{% if block.settings.hide_on_mobile %} yaomri-announcement__item--hide-mobile{% endif %}{% if block.settings.hide_on_desktop %} yaomri-announcement__item--hide-desktop{% endif %}"
                data-announcement-slide
                {{ block.shopify_attributes }}
              >
                {%- liquid
                  assign prefix = block.settings.prefix
                  assign label = block.settings.text
                  if block.settings.link != blank
                    echo '<a class="yaomri-announcement__link" href="'
                    echo block.settings.link
                    echo '"'
                    if block.settings.open_new_window
                      echo ' target="_blank" rel="noopener noreferrer"'
                    endif
                    echo '>'
                    if prefix != blank
                      echo '<span class="yaomri-announcement__prefix">'
                      echo prefix | escape
                      echo '</span>'
                    endif
                    echo '<span class="yaomri-announcement__text">'
                    echo label
                    echo '</span></a>'
                  else
                    if prefix != blank
                      echo '<span class="yaomri-announcement__prefix">'
                      echo prefix | escape
                      echo '</span>'
                    endif
                    echo '<span class="yaomri-announcement__text">'
                    echo label
                    echo '</span>'
                  endif
                -%}
              </div>
              {%- assign slide_index = slide_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if show_arrows and valid_block_count > 1 -%}
          <button type="button" class="yaomri-announcement__arrow yaomri-announcement__arrow--prev" data-announcement-prev aria-label="Previous announcement">
            {% render 'icon-yaomri-chevron-left' %}
          </button>
          <button type="button" class="yaomri-announcement__arrow yaomri-announcement__arrow--next" data-announcement-next aria-label="Next announcement">
            {% render 'icon-yaomri-chevron-right' %}
          </button>
        {%- endif -%}

        {%- if show_dots and valid_block_count > 1 -%}
          <div class="yaomri-announcement__dots" data-announcement-dots>
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <button type="button" class="yaomri-announcement__dot{% if forloop.index0 == 0 %} is-active{% endif %}" data-announcement-dot="{{ forloop.index0 }}" aria-label="Go to announcement {{ forloop.index }}"></button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="yaomri-announcement__marquee" data-announcement-marquee>
        <div class="yaomri-announcement__marquee-track">
          <div class="yaomri-announcement__marquee-group">
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <div class="yaomri-announcement__item{% if block.settings.hide_on_mobile %} yaomri-announcement__item--hide-mobile{% endif %}{% if block.settings.hide_on_desktop %} yaomri-announcement__item--hide-desktop{% endif %}" {{ block.shopify_attributes }}>
                  {%- liquid
                    assign prefix = block.settings.prefix
                    assign label = block.settings.text
                    if block.settings.link != blank
                      echo '<a class="yaomri-announcement__link" href="'
                      echo block.settings.link
                      echo '"'
                      if block.settings.open_new_window
                        echo ' target="_blank" rel="noopener noreferrer"'
                      endif
                      echo '>'
                      if prefix != blank
                        echo '<span class="yaomri-announcement__prefix">'
                        echo prefix | escape
                        echo '</span>'
                      endif
                      echo '<span class="yaomri-announcement__text">'
                      echo label
                      echo '</span></a>'
                    else
                      if prefix != blank
                        echo '<span class="yaomri-announcement__prefix">'
                        echo prefix | escape
                        echo '</span>'
                      endif
                      echo '<span class="yaomri-announcement__text">'
                      echo label
                      echo '</span>'
                    endif
                  -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="yaomri-announcement__marquee-group" aria-hidden="true">
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <div class="yaomri-announcement__item{% if block.settings.hide_on_mobile %} yaomri-announcement__item--hide-mobile{% endif %}{% if block.settings.hide_on_desktop %} yaomri-announcement__item--hide-desktop{% endif %}">
                  {%- liquid
                    assign prefix = block.settings.prefix
                    assign label = block.settings.text
                    if block.settings.link != blank
                      echo '<a class="yaomri-announcement__link" href="'
                      echo block.settings.link
                      echo '"'
                      if block.settings.open_new_window
                        echo ' target="_blank" rel="noopener noreferrer"'
                      endif
                      echo ' tabindex="-1">'
                      if prefix != blank
                        echo '<span class="yaomri-announcement__prefix">'
                        echo prefix | escape
                        echo '</span>'
                      endif
                      echo '<span class="yaomri-announcement__text">'
                      echo label
                      echo '</span></a>'
                    else
                      if prefix != blank
                        echo '<span class="yaomri-announcement__prefix">'
                        echo prefix | escape
                        echo '</span>'
                      endif
                      echo '<span class="yaomri-announcement__text">'
                      echo label
                      echo '</span>'
                    endif
                  -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_announcement_bar",
      "label": "Enable announcement bar",
      "default": true
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Mode",
      "default": "static",
      "options": [
        { "value": "static", "label": "Static" },
        { "value": "carousel", "label": "Carousel" },
        { "value": "marquee", "label": "Marquee" }
      ]
    },
    {
      "type": "select",
      "id": "bar_width",
      "label": "Bar width",
      "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "site", "label": "Site width" },
        { "value": "custom", "label": "Custom width" }
      ]
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "info": "Only applies when Bar width is Custom width.",
      "min": 700,
      "max": 2200,
      "step": 10,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#f6f4ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#e8e8e8"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom border",
      "default": false
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Height desktop",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height mobile",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "desktop_padding_inline",
      "label": "Desktop padding left/right",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_inline",
      "label": "Mobile padding left/right",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font size desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "font_weight",
      "label": "Font weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "default": 600
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -8,
      "max": 24,
      "step": 1,
      "unit": "%",
      "default": 2
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "default": "uppercase",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ]
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between items",
      "min": 8,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_padding_block",
      "label": "Padding top/bottom desktop",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_block",
      "label": "Padding top/bottom mobile",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "carousel_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "carousel_show_arrows",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "carousel_show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "header",
      "content": "Marquee"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee speed",
      "min": 14,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "marquee_pause_on_hover",
      "label": "Pause marquee on hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement_item",
      "name": "Announcement item",
      "settings": [
        {
          "type": "text",
          "id": "prefix",
          "label": "Prefix text"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Free express shipping on all UAE orders</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "hide_on_mobile",
          "label": "Hide on mobile",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "hide_on_desktop",
          "label": "Hide on desktop",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "announcement_item" },
        { "type": "announcement_item", "settings": { "text": "<p>New season arrivals now live</p>" } }
      ]
    }
  ]
}
{% endschema %}
