{{ 'mobile-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mobile-drawer.js' | asset_url }}" defer></script>

{%- liquid
  assign drawer_menu = blank
  assign drawer_menu_handle = section.settings.drawer_menu
  if drawer_menu_handle != blank
    assign drawer_menu = linklists[drawer_menu_handle]
    if drawer_menu != blank and drawer_menu.links.size == 0
      assign drawer_menu = blank
    endif
  endif
  if drawer_menu == blank
    assign drawer_menu = linklists['main-menu']
    if drawer_menu != blank and drawer_menu.links.size == 0
      assign drawer_menu = blank
    endif
  endif
-%}

{% render
  'mobile-drawer',
  section: section,
  menu: drawer_menu,
  wishlist_url: '/pages/wishlist'
%}

{% schema %}
{
  "name": "Mobile Menu",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Mobile drawer"
    },
    {
      "type": "link_list",
      "id": "drawer_menu",
      "label": "Mobile drawer menu",
      "info": "If empty, the drawer uses the store's main menu if available."
    },
    {
      "type": "text",
      "id": "mobile_menu_label",
      "label": "Drawer title",
      "default": "Menu"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_drawer_search",
      "label": "Show search field",
      "default": true
    },
    {
      "type": "text",
      "id": "mobile_drawer_search_placeholder",
      "label": "Search placeholder",
      "default": "Search CNVRT"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_drawer_footer",
      "label": "Show drawer footer",
      "info": "Shows configurable footer blocks at the bottom of the drawer.",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Add footer links, social links, and country selector blocks below."
    },
    {
      "type": "header",
      "content": "Mobile drawer style"
    },
    {
      "type": "range",
      "id": "mobile_drawer_width",
      "label": "Mobile drawer width",
      "min": 240,
      "max": 420,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "color",
      "id": "mobile_drawer_background",
      "label": "Mobile drawer background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mobile_drawer_text",
      "label": "Mobile drawer text colour",
      "default": "#111111"
    }
  ],
  "blocks": [
    {
      "type": "footer_link",
      "name": "Footer link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Footer link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "account",
              "label": "Account"
            },
            {
              "value": "heart",
              "label": "Heart"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Open in new tab",
          "default": false
        }
      ]
    },
    {
      "type": "country_selector",
      "name": "Country selector",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Country / region"
        }
      ]
    },
    {
      "type": "text_row",
      "name": "Text row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "social_link",
      "name": "Social link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Follow @yaomri"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Open in new tab",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mobile Menu",
      "blocks": [
        {
          "type": "footer_link",
          "settings": {
            "label": "Sign in / Register",
            "icon": "account"
          }
        },
        {
          "type": "footer_link",
          "settings": {
            "label": "Wishlist",
            "icon": "heart"
          }
        },
        {
          "type": "country_selector"
        },
        {
          "type": "social_link"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
