{{ 'section-single-image-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign width_mode = section.settings.section_width | default: 'full'
  assign custom_width = section.settings.custom_section_width | default: 1440
  assign desktop_height_mode = section.settings.desktop_height_mode | default: 'custom'
  assign mobile_height_mode = section.settings.mobile_height_mode | default: 'custom'
  assign desktop_horizontal = section.settings.desktop_content_horizontal | default: 'left'
  assign desktop_vertical = section.settings.desktop_content_vertical | default: 'center'
  assign desktop_text_alignment = section.settings.desktop_text_alignment | default: 'left'
  assign mobile_horizontal = section.settings.mobile_content_horizontal | default: 'center'
  assign mobile_vertical = section.settings.mobile_content_vertical | default: 'center'
  assign mobile_text_alignment = section.settings.mobile_text_alignment | default: 'center'
  assign content_width_mode = section.settings.content_width | default: 'site'
  assign custom_content_width = section.settings.custom_content_width | default: 720
  assign overlay_color = section.settings.overlay_color | default: '#000000'
  assign overlay_opacity = section.settings.overlay_opacity | default: 20 | divided_by: 100.0
  assign border_color = section.settings.border_color | default: '#e8e8e8'
  assign section_background = section.settings.section_background | default: 'var(--color-background)'

  assign desktop_justify = 'start'
  if desktop_horizontal == 'center'
    assign desktop_justify = 'center'
  elsif desktop_horizontal == 'right'
    assign desktop_justify = 'end'
  endif

  assign desktop_align = 'center'
  if desktop_vertical == 'top'
    assign desktop_align = 'start'
  elsif desktop_vertical == 'bottom'
    assign desktop_align = 'end'
  endif

  assign desktop_text = 'left'
  assign desktop_item_justify = 'start'
  if desktop_text_alignment == 'center'
    assign desktop_text = 'center'
    assign desktop_item_justify = 'center'
  elsif desktop_text_alignment == 'right'
    assign desktop_text = 'right'
    assign desktop_item_justify = 'end'
  endif

  assign mobile_justify = 'center'
  if mobile_horizontal == 'left'
    assign mobile_justify = 'start'
  elsif mobile_horizontal == 'right'
    assign mobile_justify = 'end'
  endif

  assign mobile_align = 'center'
  if mobile_vertical == 'top'
    assign mobile_align = 'start'
  elsif mobile_vertical == 'bottom'
    assign mobile_align = 'end'
  endif

  assign mobile_text = 'center'
  assign mobile_item_justify = 'center'
  if mobile_text_alignment == 'left'
    assign mobile_text = 'left'
    assign mobile_item_justify = 'start'
  elsif mobile_text_alignment == 'right'
    assign mobile_text = 'right'
    assign mobile_item_justify = 'end'
  endif

  assign section_width_value = 'var(--page-width)'
  if width_mode == 'full'
    assign section_width_value = 'none'
  elsif width_mode == 'custom'
    capture section_width_value
      echo custom_width
      echo 'px'
    endcapture
  endif

  assign content_width_value = 'var(--page-width)'
  if content_width_mode == 'full'
    assign content_width_value = '100%'
  elsif content_width_mode == 'custom'
    capture content_width_value
      echo custom_content_width
      echo 'px'
    endcapture
  endif
-%}

<section
  class="yaomri-single-hero yaomri-single-hero--width-{{ width_mode }} yaomri-single-hero--desktop-height-{{ desktop_height_mode }} yaomri-single-hero--mobile-height-{{ mobile_height_mode }}{% if section.settings.show_border %} yaomri-single-hero--border{% endif %} full-width"
  style="
    --ysh-section-width: {{ section_width_value }};
    --ysh-section-bg: {{ section_background }};
    --ysh-border-color: {{ border_color }};
    --ysh-overlay-color: {{ overlay_color }};
    --ysh-overlay-opacity: {{ overlay_opacity }};
    --ysh-desktop-justify: {{ desktop_justify }};
    --ysh-desktop-align: {{ desktop_align }};
    --ysh-desktop-text-align: {{ desktop_text }};
    --ysh-desktop-item-justify: {{ desktop_item_justify }};
    --ysh-mobile-justify: {{ mobile_justify }};
    --ysh-mobile-align: {{ mobile_align }};
    --ysh-mobile-text-align: {{ mobile_text }};
    --ysh-mobile-item-justify: {{ mobile_item_justify }};
    --ysh-content-width: {{ content_width_value }};
    --ysh-content-gap: {{ section.settings.content_gap }}px;
    --ysh-content-padding: {{ section.settings.content_padding }}px;
    --ysh-height-desktop: {{ section.settings.desktop_custom_height }}px;
    --ysh-height-mobile: {{ section.settings.mobile_custom_height }}px;
    --ysh-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --ysh-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --ysh-padding-left-desktop: {{ section.settings.padding_left_desktop }}px;
    --ysh-padding-right-desktop: {{ section.settings.padding_right_desktop }}px;
    --ysh-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --ysh-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --ysh-padding-left-mobile: {{ section.settings.padding_left_mobile }}px;
    --ysh-padding-right-mobile: {{ section.settings.padding_right_mobile }}px;
    --ysh-margin-top-desktop: {{ section.settings.margin_top_desktop }}px;
    --ysh-margin-bottom-desktop: {{ section.settings.margin_bottom_desktop }}px;
    --ysh-margin-top-mobile: {{ section.settings.margin_top_mobile }}px;
    --ysh-margin-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="yaomri-single-hero__frame">
    <div class="yaomri-single-hero__stage" style="--ysh-image-position: {{ section.settings.image_position }};">
      <div class="yaomri-single-hero__media">
        {%- if section.settings.desktop_image != blank -%}
          {%- assign image_class = 'yaomri-single-hero__image' -%}
          {%- if section.settings.mobile_image != blank -%}
            {%- assign image_class = image_class | append: ' yaomri-single-hero__image--has-mobile' -%}
          {%- endif -%}
          {{
            section.settings.desktop_image
            | image_url: width: 2400
            | image_tag:
              class: image_class,
              widths: '720, 960, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              loading: 'eager',
              alt: section.settings.desktop_image.alt | default: shop.name | escape
          }}
        {%- else -%}
          <div class="yaomri-single-hero__placeholder" data-label="Add hero image"></div>
        {%- endif -%}

        {%- if section.settings.mobile_image != blank -%}
          {{
            section.settings.mobile_image
            | image_url: width: 1200
            | image_tag:
              class: 'yaomri-single-hero__image yaomri-single-hero__mobile-image',
              widths: '360, 540, 720, 900, 1200',
              sizes: '100vw',
              loading: 'eager',
              alt: section.settings.mobile_image.alt | default: shop.name | escape
          }}
        {%- endif -%}
      </div>

      <div class="yaomri-single-hero__overlay"></div>

      <div class="yaomri-single-hero__content">
        <div class="yaomri-single-hero__content-stack">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'eyebrow' -%}
                {%- if block.settings.text != blank -%}
                  {%- liquid
                    assign eyebrow_size_desktop = block.settings.eyebrow_size_desktop | default: block.settings.font_size_desktop | default: 12
                    assign eyebrow_size_mobile = block.settings.eyebrow_size_mobile | default: block.settings.font_size_mobile | default: 11
                    assign eyebrow_weight = block.settings.eyebrow_weight | default: block.settings.font_weight | default: '700'
                    assign eyebrow_line_height = block.settings.eyebrow_line_height | default: 100
                    assign eyebrow_letter_spacing = block.settings.eyebrow_letter_spacing | default: block.settings.letter_spacing | default: 1
                    assign eyebrow_text_transform = block.settings.eyebrow_text_transform | default: 'uppercase'
                    if eyebrow_text_transform == blank
                      if block.settings.uppercase == false
                        assign eyebrow_text_transform = 'none'
                      else
                        assign eyebrow_text_transform = 'uppercase'
                      endif
                    endif
                    assign eyebrow_max_width = block.settings.eyebrow_max_width | default: 0
                    assign eyebrow_color = block.settings.eyebrow_colour | default: block.settings.color
                    assign eyebrow_margin_bottom = block.settings.eyebrow_margin_bottom | default: block.settings.margin_bottom | default: 0
                    assign text_style = ''
                    if eyebrow_size_desktop != blank
                      capture text_style
                        echo text_style
                        echo '--ysh-eyebrow-size-desktop: '
                        echo eyebrow_size_desktop
                        echo 'px;'
                      endcapture
                    endif
                    if eyebrow_size_mobile != blank
                      capture text_style
                        echo text_style
                        echo '--ysh-eyebrow-size-mobile: '
                        echo eyebrow_size_mobile
                        echo 'px;'
                      endcapture
                    endif
                    if eyebrow_weight != blank
                      capture text_style
                        echo text_style
                        echo '--ysh-eyebrow-weight: '
                        echo eyebrow_weight
                        echo ';'
                      endcapture
                    endif
                    if eyebrow_line_height != blank
                      capture text_style
                        echo text_style
                        echo '--ysh-eyebrow-line-height: '
                        echo eyebrow_line_height
                        echo '%;'
                      endcapture
                    endif
                    if eyebrow_letter_spacing != blank
                      capture text_style
                        echo text_style
                        echo '--ysh-eyebrow-letter-spacing: '
                        echo eyebrow_letter_spacing
                        echo 'px;'
                      endcapture
                    endif
                    if eyebrow_text_transform != blank
                      capture text_style
                        echo text_style
                        echo '--ysh-eyebrow-transform: '
                        echo eyebrow_text_transform
                        echo ';'
                      endcapture
                    endif
                    if eyebrow_max_width > 0
                      capture text_style
                        echo text_style
                        echo '--ysh-eyebrow-max-width: '
                        echo eyebrow_max_width
                        echo 'px;'
                      endcapture
                    endif
                    if eyebrow_color != blank
                      capture text_style
                        echo text_style
                        echo '--ysh-block-text-color: '
                        echo eyebrow_color
                        echo ';'
                      endcapture
                    endif
                    capture text_style
                      echo text_style
                      echo '--ysh-block-margin-bottom: '
                      echo eyebrow_margin_bottom
                      echo 'px;'
                    endcapture
                  -%}
                  <div
                    class="yaomri-single-hero__block yaomri-single-hero__eyebrow-block"
                    style="{{ text_style }}"
                    {{ block.shopify_attributes }}
                  >
                    <p class="yaomri-single-hero__eyebrow">{{ block.settings.text }}</p>
                  </div>
                {%- endif -%}

              {%- when 'heading' -%}
                {%- liquid
                  assign heading_text = block.settings.heading_text | default: block.settings.heading
                -%}
                {%- if heading_text != blank -%}
                  {%- liquid
                    assign heading_size_desktop = block.settings.heading_size_desktop | default: block.settings.font_size_desktop | default: 72
                    assign heading_size_mobile = block.settings.heading_size_mobile | default: block.settings.font_size_mobile | default: 42
                    assign heading_weight = block.settings.heading_weight | default: block.settings.font_weight | default: '800'
                    assign heading_line_height_desktop = block.settings.heading_line_height_desktop | default: block.settings.line_height_desktop | default: 105
                    assign heading_line_height_mobile = block.settings.heading_line_height_mobile | default: block.settings.line_height_mobile | default: 115
                    assign heading_letter_spacing = block.settings.heading_letter_spacing | default: block.settings.letter_spacing | default: 0
                    assign heading_text_transform = block.settings.heading_text_transform | default: 'none'
                    assign heading_max_width = block.settings.heading_max_width | default: block.settings.max_width | default: 0
                    assign heading_colour = block.settings.heading_colour | default: block.settings.color
                    assign heading_margin_bottom = block.settings.heading_margin_bottom | default: block.settings.margin_bottom | default: 0
                    assign heading_style = ''
                    if heading_size_desktop != blank
                      capture heading_style
                        echo heading_style
                        echo '--ysh-heading-size-desktop: '
                        echo heading_size_desktop
                        echo 'px;'
                      endcapture
                    endif
                    if heading_size_mobile != blank
                      capture heading_style
                        echo heading_style
                        echo '--ysh-heading-size-mobile: '
                        echo heading_size_mobile
                        echo 'px;'
                      endcapture
                    endif
                    if heading_weight != blank
                      capture heading_style
                        echo heading_style
                        echo '--ysh-heading-weight: '
                        echo heading_weight
                        echo ';'
                      endcapture
                    endif
                    if heading_line_height_desktop != blank
                      capture heading_style
                        echo heading_style
                        echo '--ysh-heading-line-height-desktop: '
                        echo heading_line_height_desktop
                        echo '%;'
                      endcapture
                    endif
                    if heading_line_height_mobile != blank
                      capture heading_style
                        echo heading_style
                        echo '--ysh-heading-line-height-mobile: '
                        echo heading_line_height_mobile
                        echo '%;'
                      endcapture
                    endif
                    if heading_letter_spacing != blank
                      capture heading_style
                        echo heading_style
                        echo '--ysh-heading-letter-spacing: '
                        echo heading_letter_spacing
                        echo 'px;'
                      endcapture
                    endif
                    if heading_text_transform != blank
                      capture heading_style
                        echo heading_style
                        echo '--ysh-heading-transform: '
                        echo heading_text_transform
                        echo ';'
                      endcapture
                    endif
                    if heading_colour != blank
                      capture heading_style
                        echo heading_style
                        echo '--ysh-block-text-color: '
                        echo heading_colour
                        echo ';'
                      endcapture
                    endif
                    if heading_max_width > 0
                      capture heading_style
                        echo heading_style
                        echo '--ysh-heading-max-width: '
                        echo heading_max_width
                        echo 'px;'
                      endcapture
                    endif
                    capture heading_style
                      echo heading_style
                      echo '--ysh-block-margin-bottom: '
                      echo heading_margin_bottom
                      echo 'px;'
                    endcapture
                  -%}
                  <div
                    class="yaomri-single-hero__block yaomri-single-hero__heading-block"
                    style="{{ heading_style }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.heading_tag == 'h2' -%}
                      <h2 class="yaomri-single-hero__heading">{{ heading_text }}</h2>
                    {%- else -%}
                      <h1 class="yaomri-single-hero__heading">{{ heading_text }}</h1>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'paragraph' -%}
                {%- if block.settings.text != blank -%}
                  {%- liquid
                    assign text_size_desktop = block.settings.text_size_desktop | default: block.settings.font_size_desktop | default: 18
                    assign text_size_mobile = block.settings.text_size_mobile | default: block.settings.font_size_mobile | default: 16
                    assign text_weight = block.settings.text_weight | default: block.settings.font_weight | default: '400'
                    assign text_line_height_desktop = block.settings.text_line_height_desktop | default: block.settings.line_height_desktop | default: 150
                    assign text_line_height_mobile = block.settings.text_line_height_mobile | default: block.settings.line_height_mobile | default: 160
                    assign text_letter_spacing = block.settings.text_letter_spacing | default: block.settings.letter_spacing | default: 0
                    assign text_max_width = block.settings.text_max_width | default: block.settings.max_width | default: 0
                    assign text_colour = block.settings.text_colour | default: block.settings.color
                    assign text_margin_bottom = block.settings.text_margin_bottom | default: block.settings.margin_bottom | default: 0
                    assign paragraph_style = ''
                    if text_size_desktop != blank
                      capture paragraph_style
                        echo paragraph_style
                        echo '--ysh-text-size-desktop: '
                        echo text_size_desktop
                        echo 'px;'
                      endcapture
                    endif
                    if text_size_mobile != blank
                      capture paragraph_style
                        echo paragraph_style
                        echo '--ysh-text-size-mobile: '
                        echo text_size_mobile
                        echo 'px;'
                      endcapture
                    endif
                    if text_weight != blank
                      capture paragraph_style
                        echo paragraph_style
                        echo '--ysh-text-weight: '
                        echo text_weight
                        echo ';'
                      endcapture
                    endif
                    if text_line_height_desktop != blank
                      capture paragraph_style
                        echo paragraph_style
                        echo '--ysh-text-line-height-desktop: '
                        echo text_line_height_desktop
                        echo '%;'
                      endcapture
                    endif
                    if text_line_height_mobile != blank
                      capture paragraph_style
                        echo paragraph_style
                        echo '--ysh-text-line-height-mobile: '
                        echo text_line_height_mobile
                        echo '%;'
                      endcapture
                    endif
                    if text_letter_spacing != blank
                      capture paragraph_style
                        echo paragraph_style
                        echo '--ysh-text-letter-spacing: '
                        echo text_letter_spacing
                        echo 'px;'
                      endcapture
                    endif
                    if text_colour != blank
                      capture paragraph_style
                        echo paragraph_style
                        echo '--ysh-block-text-color: '
                        echo text_colour
                        echo ';'
                      endcapture
                    endif
                    if text_max_width > 0
                      capture paragraph_style
                        echo paragraph_style
                        echo '--ysh-text-max-width: '
                        echo text_max_width
                        echo 'px;'
                      endcapture
                    endif
                    capture paragraph_style
                      echo paragraph_style
                      echo '--ysh-block-margin-bottom: '
                      echo text_margin_bottom
                      echo 'px;'
                    endcapture
                  -%}
                  <div
                    class="yaomri-single-hero__block yaomri-single-hero__paragraph-block"
                    style="{{ paragraph_style }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="yaomri-single-hero__text">{{ block.settings.text }}</div>
                  </div>
                {%- endif -%}

              {%- when 'button' -%}
                {%- if block.settings.label != blank and block.settings.link != blank -%}
                  {%- liquid
                    assign button_size = block.settings.button_size | default: 13
                    assign button_weight = block.settings.button_weight | default: '700'
                    assign button_letter_spacing_raw = block.settings.button_letter_spacing | default: 6
                    assign button_letter_spacing = button_letter_spacing_raw | times: 0.01
                    assign button_text_transform = block.settings.button_text_transform | default: 'uppercase'
                  -%}
                  <div
                    class="yaomri-single-hero__block yaomri-single-hero__button-block"
                    style="
                      --ysh-block-margin-top: {{ block.settings.margin_top }}px;
                      --ysh-button-size: {{ button_size }}px;
                      --ysh-button-weight: {{ button_weight }};
                      --ysh-button-letter-spacing: {{ button_letter_spacing }}em;
                      --ysh-button-transform: {{ button_text_transform }};
                    "
                    {{ block.shopify_attributes }}
                  >
                    <a
                      class="yaomri-single-hero__button yaomri-single-hero__button--{{ block.settings.style }}{% if block.settings.full_width_mobile %} yaomri-single-hero__button--mobile-full{% endif %}"
                      href="{{ block.settings.link }}"
                      {% if block.settings.open_new_window %}target="_blank" rel="noopener noreferrer"{% endif %}
                    >
                      <span>{{ block.settings.label }}</span>
                    </a>
                  </div>
                {%- endif -%}

              {%- when 'button_group' -%}
                {%- liquid
                  assign has_primary = false
                  assign has_secondary = false
                  assign button_size = block.settings.button_size | default: 13
                  assign button_weight = block.settings.button_weight | default: '700'
                  assign button_letter_spacing_raw = block.settings.button_letter_spacing | default: 6
                  assign button_letter_spacing = button_letter_spacing_raw | times: 0.01
                  assign button_text_transform = block.settings.button_text_transform | default: 'uppercase'
                  if block.settings.primary_label != blank and block.settings.primary_link != blank
                    assign has_primary = true
                  endif
                  if block.settings.secondary_label != blank and block.settings.secondary_link != blank
                    assign has_secondary = true
                  endif
                -%}
                {%- if has_primary or has_secondary -%}
                  <div
                    class="yaomri-single-hero__block yaomri-single-hero__buttons{% if block.settings.stack_on_mobile %} yaomri-single-hero__buttons--stack-mobile{% endif %}"
                    style="
                      --ysh-block-margin-top: {{ block.settings.margin_top }}px;
                      --ysh-button-size: {{ button_size }}px;
                      --ysh-button-weight: {{ button_weight }};
                      --ysh-button-letter-spacing: {{ button_letter_spacing }}em;
                      --ysh-button-transform: {{ button_text_transform }};
                    "
                    {{ block.shopify_attributes }}
                  >
                    {%- if has_primary -%}
                      <a class="yaomri-single-hero__button yaomri-single-hero__button--{{ block.settings.primary_style }}" href="{{ block.settings.primary_link }}">
                        <span>{{ block.settings.primary_label }}</span>
                      </a>
                    {%- endif -%}
                    {%- if has_secondary -%}
                      <a class="yaomri-single-hero__button yaomri-single-hero__button--{{ block.settings.secondary_style }}" href="{{ block.settings.secondary_link }}">
                        <span>{{ block.settings.secondary_label }}</span>
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'custom_html' -%}
                {%- if block.settings.html != blank -%}
                  <div class="yaomri-single-hero__block yaomri-single-hero__custom-html" {{ block.shopify_attributes }}>
                    {{ block.settings.html }}
                  </div>
                {%- endif -%}

              {%- when 'custom_liquid' -%}
                {%- if block.settings.liquid != blank -%}
                  <div class="yaomri-single-hero__block yaomri-single-hero__custom-liquid" {{ block.shopify_attributes }}>
                    {{ block.settings.liquid }}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'image_pin' -%}
          {%- liquid
            assign pin_label = block.settings.pin_label
            assign pin_accessible_label = pin_label
            if pin_accessible_label == blank
              assign pin_accessible_label = 'Hero image pin'
            endif
            assign pin_tag = 'div'
            if block.settings.link != blank
              assign pin_tag = 'a'
            endif
          -%}
          <{{ pin_tag }}
            class="yaomri-single-hero__pin yaomri-single-hero__pin--{{ block.settings.pin_style }}{% unless block.settings.show_on_mobile %} yaomri-single-hero__pin--hide-mobile{% endunless %}"
            style="
              --ysh-pin-x-desktop: {{ block.settings.position_x_desktop }}%;
              --ysh-pin-y-desktop: {{ block.settings.position_y_desktop }}%;
              --ysh-pin-x-mobile: {{ block.settings.position_x_mobile }}%;
              --ysh-pin-y-mobile: {{ block.settings.position_y_mobile }}%;
              --ysh-pin-bg: {{ block.settings.pin_color }};
              --ysh-pin-text: {{ block.settings.pin_text_color }};
            "
            {% if block.settings.link != blank %}href="{{ block.settings.link }}" aria-label="{{ pin_accessible_label | escape }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.pin_style == 'dot' and pin_label == blank -%}
              <span class="visually-hidden">{{ pin_accessible_label }}</span>
            {%- elsif block.settings.pin_style == 'numbered' -%}
              <span>{{ pin_label | default: forloop.index }}</span>
            {%- else -%}
              <span>{{ pin_label }}</span>
            {%- endif -%}
          </{{ pin_tag }}>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Single Image Hero",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full",
      "options": [
        {
          "value": "site",
          "label": "Site width"
        },
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "range",
      "id": "custom_section_width",
      "label": "Custom section width",
      "min": 720,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "select",
      "id": "desktop_height_mode",
      "label": "Desktop height mode",
      "default": "custom",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "custom",
          "label": "Custom height"
        }
      ]
    },
    {
      "type": "range",
      "id": "desktop_custom_height",
      "label": "Desktop custom height",
      "min": 360,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 680,
      "info": "Only applies when Desktop height mode is Custom height."
    },
    {
      "type": "select",
      "id": "mobile_height_mode",
      "label": "Mobile height mode",
      "default": "custom",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
