  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "select",
          "id": "text_type",
          "label": "Text type",
          "default": "paragraph",
          "options": [
            {
              "value": "eyebrow",
              "label": "Eyebrow"
            },
            {
              "value": "heading",
              "label": "Heading"
            },
            {
              "value": "paragraph",
              "label": "Paragraph"
            }
          ]
        },
        {
          "type": "richtext",
          "id": "text_content",
