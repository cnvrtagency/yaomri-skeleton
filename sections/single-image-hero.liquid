{{ 'section-single-image-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign width_mode = section.settings.section_width | default: 'full'
  assign custom_width = section.settings.custom_section_width | default: 1440
  assign desktop_height_mode = section.settings.desktop_height_mode | default: 'custom'
  assign mobile_height_mode = section.settings.mobile_height_mode | default: 'custom'
  assign content_position = section.settings.content_position | default: 'left'
  assign text_alignment = section.settings.text_alignment | default: 'left'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign overlay_color = section.settings.overlay_color | default: '#000000'
  assign overlay_opacity = section.settings.overlay_opacity | default: 20 | divided_by: 100.0
  assign border_color = section.settings.border_color | default: '#e8e8e8'
  assign section_background = section.settings.section_background | default: 'var(--color-background)'

  assign content_justify = 'start'
  if content_position == 'center'
    assign content_justify = 'center'
  elsif content_position == 'right'
    assign content_justify = 'end'
  endif

  assign text_align = 'left'
  assign text_justify = 'start'
  if text_alignment == 'center'
    assign text_align = 'center'
    assign text_justify = 'center'
  elsif text_alignment == 'right'
    assign text_align = 'right'
    assign text_justify = 'end'
  endif

  assign section_width_value = 'var(--page-width)'
  if width_mode == 'full'
    assign section_width_value = 'none'
  elsif width_mode == 'custom'
    capture section_width_value
      echo custom_width
      echo 'px'
    endcapture
  endif

  assign has_primary_button = false
  assign has_secondary_button = false
  if section.settings.primary_button_label != blank and section.settings.primary_button_link != blank
    assign has_primary_button = true
  endif
  if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank
    assign has_secondary_button = true
  endif
-%}

<section
  class="yaomri-single-hero yaomri-single-hero--width-{{ width_mode }} yaomri-single-hero--desktop-height-{{ desktop_height_mode }} yaomri-single-hero--mobile-height-{{ mobile_height_mode }}{% if section.settings.show_border %} yaomri-single-hero--border{% endif %} full-width"
  style="
    --ysh-section-width: {{ section_width_value }};
    --ysh-section-bg: {{ section_background }};
    --ysh-text: {{ text_color }};
    --ysh-border-color: {{ border_color }};
    --ysh-overlay-color: {{ overlay_color }};
    --ysh-overlay-opacity: {{ overlay_opacity }};
    --ysh-content-justify: {{ content_justify }};
    --ysh-text-align: {{ text_align }};
    --ysh-text-justify: {{ text_justify }};
    --ysh-height-desktop: {{ section.settings.desktop_custom_height }}px;
    --ysh-height-mobile: {{ section.settings.mobile_custom_height }}px;
    --ysh-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --ysh-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --ysh-padding-left-desktop: {{ section.settings.padding_left_desktop }}px;
    --ysh-padding-right-desktop: {{ section.settings.padding_right_desktop }}px;
    --ysh-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --ysh-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --ysh-padding-left-mobile: {{ section.settings.padding_left_mobile }}px;
    --ysh-padding-right-mobile: {{ section.settings.padding_right_mobile }}px;
    --ysh-margin-top-desktop: {{ section.settings.margin_top_desktop }}px;
    --ysh-margin-bottom-desktop: {{ section.settings.margin_bottom_desktop }}px;
    --ysh-margin-top-mobile: {{ section.settings.margin_top_mobile }}px;
    --ysh-margin-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="yaomri-single-hero__frame">
    <div class="yaomri-single-hero__stage" style="--ysh-image-position: {{ section.settings.image_position }};">
      <div class="yaomri-single-hero__media">
        {%- if section.settings.desktop_image != blank -%}
          {%- assign image_class = 'yaomri-single-hero__image' -%}
          {%- if section.settings.mobile_image != blank -%}
            {%- assign image_class = image_class | append: ' yaomri-single-hero__image--has-mobile' -%}
          {%- endif -%}
          {{
            section.settings.desktop_image
            | image_url: width: 2400
            | image_tag:
              class: image_class,
              widths: '720, 960, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              loading: 'eager',
              alt: section.settings.desktop_image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          <div class="yaomri-single-hero__placeholder" data-label="Add hero image"></div>
        {%- endif -%}

        {%- if section.settings.mobile_image != blank -%}
          {{
            section.settings.mobile_image
            | image_url: width: 1200
            | image_tag:
              class: 'yaomri-single-hero__image yaomri-single-hero__mobile-image',
              widths: '360, 540, 720, 900, 1200',
              sizes: '100vw',
              loading: 'eager',
              alt: section.settings.mobile_image.alt | default: section.settings.heading | escape
          }}
        {%- endif -%}
      </div>

      <div class="yaomri-single-hero__overlay"></div>

      <div class="yaomri-single-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="yaomri-single-hero__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="yaomri-single-hero__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="yaomri-single-hero__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if has_primary_button or has_secondary_button -%}
          <div class="yaomri-single-hero__buttons">
            {%- if has_primary_button -%}
              <a class="yaomri-single-hero__button yaomri-single-hero__button--primary" href="{{ section.settings.primary_button_link }}">
                <span>{{ section.settings.primary_button_label }}</span>
              </a>
            {%- endif -%}
            {%- if has_secondary_button -%}
              <a class="yaomri-single-hero__button yaomri-single-hero__button--secondary" href="{{ section.settings.secondary_button_link }}">
                {{ section.settings.secondary_button_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Single Image Hero",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full",
      "options": [
        {
          "value": "site",
          "label": "Site width"
        },
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "range",
      "id": "custom_section_width",
      "label": "Custom section width",
      "min": 720,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "select",
      "id": "desktop_height_mode",
      "label": "Desktop height mode",
      "default": "custom",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "custom",
          "label": "Custom height"
        }
      ]
    },
    {
      "type": "range",
      "id": "desktop_custom_height",
      "label": "Desktop custom height",
      "min": 360,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 680,
      "info": "Only applies when Desktop height mode is Custom height."
    },
    {
      "type": "select",
      "id": "mobile_height_mode",
      "label": "Mobile height mode",
      "default": "custom",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "custom",
          "label": "Custom height"
        }
      ]
    },
    {
      "type": "range",
      "id": "mobile_custom_height",
      "label": "Mobile custom height",
      "min": 360,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 560,
      "info": "Only applies when Mobile height mode is Custom height."
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show outer border",
      "default": false
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#e8e8e8"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Replaces the desktop image on mobile."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "center center",
      "options": [
        {
          "value": "center center",
          "label": "Centre"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Hero text colour",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Swimwear with intention"
    },
    {
