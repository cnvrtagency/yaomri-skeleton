{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-featured-collection.js' | asset_url }}" defer></script>

{%- liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank and section.settings.collection != blank
    assign featured_collection = collections[section.settings.collection]
  endif

  assign layout_mode = section.settings.layout | default: 'grid'
  assign products_to_show = section.settings.products_to_show | default: 8
  assign section_width = section.settings.section_width | default: 'site'
  assign custom_section_width = section.settings.custom_section_width | default: 1400
  assign has_collection = false
  assign has_products = false

  if featured_collection != blank
    assign has_collection = true
    if featured_collection.products_count > 0
      assign has_products = true
    endif
  endif

  assign should_render = false
  if has_products or request.design_mode
    assign should_render = true
  endif

  assign root_classes = 'cnvrt-featured-collection full-width'
  assign root_classes = root_classes | append: ' cnvrt-featured-collection--layout-' | append: layout_mode
  assign root_classes = root_classes | append: ' cnvrt-featured-collection--width-' | append: section_width
  if section.settings.show_top_border
    assign root_classes = root_classes | append: ' cnvrt-featured-collection--border-top'
  endif
-%}

{%- if should_render -%}
  <section
    class="{{ root_classes }}"
    data-cnvrt-featured-collection
    data-cnvrt-featured-collection-layout="{{ layout_mode }}"
    {{ section.shopify_attributes }}
    style="
      --cnvrt-featured-collection-custom-width: {{ custom_section_width }}px;
      --cnvrt-featured-collection-gap-desktop: {{ section.settings.gap_desktop }}px;
      --cnvrt-featured-collection-gap-mobile: {{ section.settings.gap_mobile }}px;
      --cnvrt-featured-collection-columns-desktop: {{ section.settings.columns_desktop }};
      --cnvrt-featured-collection-columns-tablet: {{ section.settings.columns_tablet }};
      --cnvrt-featured-collection-columns-mobile: {{ section.settings.columns_mobile }};
      --cnvrt-featured-collection-cards-desktop: {{ section.settings.carousel_cards_desktop }};
      --cnvrt-featured-collection-cards-tablet: {{ section.settings.carousel_cards_tablet }};
      --cnvrt-featured-collection-cards-mobile: {{ section.settings.carousel_cards_mobile }};
      --cnvrt-featured-collection-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
      --cnvrt-featured-collection-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
      --cnvrt-featured-collection-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
      --cnvrt-featured-collection-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --cnvrt-featured-collection-bg: {{ section.settings.background_colour }};
      --cnvrt-featured-collection-text: {{ section.settings.text_colour }};
      --cnvrt-featured-collection-border: {{ section.settings.border_colour }};
    "
  >
    <div class="cnvrt-featured-collection__inner">
      <header class="cnvrt-featured-collection__header cnvrt-section-heading cnvrt-section-heading--align-{{ settings.section_heading_alignment | default: 'left' }}">
        <div class="cnvrt-featured-collection__heading-group cnvrt-section-heading__content">
          {%- if section.settings.eyebrow != blank -%}
            <p class="cnvrt-featured-collection__eyebrow cnvrt-section-heading__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="cnvrt-featured-collection__heading cnvrt-section-heading__title">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="cnvrt-featured-collection__text cnvrt-section-heading__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
        <div class="cnvrt-featured-collection__actions cnvrt-section-heading__actions">
          {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
            <a class="cnvrt-featured-collection__button" href="{{ section.settings.cta_link }}">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
          {%- if layout_mode == 'carousel' and section.settings.show_arrows -%}
            <div class="cnvrt-featured-collection__nav">
              <button
                class="cnvrt-featured-collection__arrow"
                type="button"
                data-cnvrt-featured-collection-prev
                aria-label="Previous products"
              >
                {% render 'icon-cnvrt-chevron-left' %}
              </button>
              <button
                class="cnvrt-featured-collection__arrow"
                type="button"
                data-cnvrt-featured-collection-next
                aria-label="Next products"
              >
                {% render 'icon-cnvrt-chevron-right' %}
              </button>
            </div>
          {%- endif -%}
        </div>
      </header>

      {%- if has_products -%}
        {%- if layout_mode == 'grid' -%}
          <div class="cnvrt-featured-collection__grid">
            {%- for product in featured_collection.products limit: products_to_show -%}
              <div class="cnvrt-featured-collection__item">
                {% render 'product-card', product: product, section_id: section.id %}
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="cnvrt-featured-collection__track" data-cnvrt-featured-collection-track>
            {%- for product in featured_collection.products limit: products_to_show -%}
              <div class="cnvrt-featured-collection__item">
                {% render 'product-card', product: product, section_id: section.id %}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- elsif request.design_mode -%}
        <div class="cnvrt-featured-collection__empty">
          {%- if has_collection -%}
            This collection has no products. Add products to preview this section.
          {%- else -%}
            Select a collection to preview featured products.
          {%- endif -%}
        </div>
        <div class="cnvrt-featured-collection__grid">
          {%- for i in (1..4) -%}
            <article class="cnvrt-featured-collection__item cnvrt-featured-collection__item--placeholder">
              <div class="cnvrt-featured-collection__placeholder-media">{{ 'product-1' | placeholder_svg_tag }}</div>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the edit" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View all" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ]
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "site",
      "options": [
        { "value": "site", "label": "Site width" },
        { "value": "full", "label": "Full width" },
        { "value": "custom", "label": "Custom width" }
      ]
    },
    {
      "type": "range",
      "id": "custom_section_width",
      "label": "Custom section width",
      "min": 700,
      "max": 2200,
      "step": 20,
      "default": 1400,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ]
    },

    { "type": "header", "content": "Products" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Products per row desktop",
      "default": "4",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ]
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Products per row tablet",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Products per row mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },

    { "type": "header", "content": "Carousel" },
    {
      "type": "select",
      "id": "carousel_cards_desktop",
      "label": "Cards visible desktop",
      "default": "4",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ]
    },
    {
      "type": "select",
      "id": "carousel_cards_tablet",
      "label": "Cards visible tablet",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "select",
      "id": "carousel_cards_mobile",
      "label": "Cards visible mobile",
      "default": "1.5",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "1.2", "label": "1.2" },
        { "value": "1.5", "label": "1.5" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show carousel arrows",
      "default": true
    },
    { "type": "header", "content": "Colours" },
    {
      "type": "color",
      "id": "background_colour",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_colour",
      "label": "Text colour",
      "default": "#111111"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top border",
      "default": false
    },
    {
      "type": "color",
      "id": "border_colour",
      "label": "Border colour",
      "default": "#e8e8e8"
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Gap desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap mobile",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 32,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "settings": {
        "heading": "Featured collection",
        "eyebrow": "Shop the edit",
        "layout": "grid",
        "products_to_show": 8
      }
    }
  ]
}
{% endschema %}
