{%- liquid
  assign card_has_link = false
  if card_link != blank
    assign card_has_link = true
  endif

  assign card_cta_text = card_cta_label
  if card_cta_text == blank
    assign card_cta_text = 'Shop now'
  endif
-%}

{%- capture card_inner -%}
  <div class="yaomri-collection-card__media-wrap">
    {%- if card_image != blank -%}
      {{
        card_image
        | image_url: width: 1600
        | image_tag:
          class: 'yaomri-collection-card__media',
          widths: '320, 480, 640, 800, 1000, 1200, 1400, 1600',
          sizes: '(max-width: 989px) 100vw, 50vw',
          loading: 'lazy',
          alt: card_title | default: card_image.alt | escape
      }}
    {%- else -%}
      <div class="yaomri-collection-card__media yaomri-collection-card__media--placeholder" aria-hidden="true"></div>
    {%- endif -%}
    <div
      class="yaomri-collection-card__overlay"
      style="--ycc-card-overlay-color: {{ card_overlay_color | default: '#000000' }}; --ycc-card-overlay-opacity: {{ card_overlay_opacity | default: 20 | divided_by: 100.0 }};"
    ></div>
  </div>
  <div class="yaomri-collection-card__content"{% if card_text_colour != blank %} style="--ycc-card-text-override: {{ card_text_colour }};"{% endif %}>
    {%- if card_badge != blank -%}
      <p class="yaomri-collection-card__badge">{{ card_badge }}</p>
    {%- endif -%}
    {%- if card_title != blank -%}
      <h3 class="yaomri-collection-card__title">{{ card_title }}</h3>
    {%- endif -%}
    {%- if card_subtitle != blank -%}
      <p class="yaomri-collection-card__subtitle">{{ card_subtitle }}</p>
    {%- endif -%}
    {%- if show_card_cta and card_has_link -%}
      <span class="yaomri-collection-card__cta yaomri-collection-card__cta--{{ cta_style }}">
        {{ card_cta_text }}
      </span>
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- if card_has_link -%}
  <a
    class="yaomri-collection-card yaomri-collection-card--linked yaomri-collection-card--hover-{{ image_hover_effect | default: 'none' }} yaomri-collection-card--fit-{{ image_fit | default: 'cover' }}"
    href="{{ card_link }}"
    {% if open_new_window %}target="_blank" rel="noopener noreferrer"{% endif %}
    aria-label="{{ card_title | default: card_cta_text | escape }}"
    style="--ycc-card-image-position: {{ card_image_position | default: 'center center' }};"
  >
    {{ card_inner }}
  </a>
{%- else -%}
  <article
    class="yaomri-collection-card yaomri-collection-card--hover-{{ image_hover_effect | default: 'none' }} yaomri-collection-card--fit-{{ image_fit | default: 'cover' }}"
    style="--ycc-card-image-position: {{ card_image_position | default: 'center center' }};"
  >
    {{ card_inner }}
  </article>
{%- endif -%}
