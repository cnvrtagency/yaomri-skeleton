{%- liquid
  assign parent_id = parent_block.settings.parent_id | strip
  assign panel_content_width_value = panel_content_width | default: 1200
  assign packery_enabled = true
  if parent_block.settings.enable_packery == false
    assign packery_enabled = false
  endif
  assign has_panel_content = false
  for block in all_blocks
    if block.type == 'linklist_child' or block.type == 'image_tile_child'
      assign child_parent_id = block.settings.parent_id | strip
      if child_parent_id == parent_id and child_parent_id != blank
        assign has_panel_content = true
        break
      endif
    endif
  endfor
-%}

{%- if parent_id != blank and has_panel_content -%}
  <section
    class="yaomri-mega-panel{% if packery_enabled %} yaomri-mega-panel--packery{% else %} yaomri-mega-panel--rows{% endif %}"
    data-mega-panel
    data-mega-parent="{{ parent_id | escape }}"
    hidden
    {{ parent_block.shopify_attributes }}
  >
    <div
      class="yaomri-mega-panel__inner"
      style="--ym-panel-content-width: {{ panel_content_width_value }}px;"
    >
      <div class="yaomri-mega-panel__grid{% if packery_enabled %} yaomri-mega-panel__grid--packery{% else %} yaomri-mega-panel__grid--rows{% endif %}">
        {%- for block in all_blocks -%}
          {%- liquid
            assign child_parent_id = block.settings.parent_id | strip
          -%}
          {%- if child_parent_id == parent_id and block.type == 'linklist_child' -%}
            {%- liquid
              assign column_width_value = block.settings.column_width | default: '25'
              assign column_width_number = column_width_value | plus: 0
              if column_width_number <= 0 or column_width_number > 100
                assign column_width_number = 25
              endif
              assign column_span = 3
              case column_width_number
                when 20
                  assign column_span = 2
                when 25
                  assign column_span = 3
                when 33
                  assign column_span = 4
                when 50
                  assign column_span = 6
                when 66
                  assign column_span = 8
                when 75
                  assign column_span = 9
                when 100
                  assign column_span = 12
              endcase
              assign child_menu = blank
              if block.settings.menu != blank
                assign child_menu = linklists[block.settings.menu]
                if child_menu != blank and child_menu.links.size == 0
                  assign child_menu = blank
                endif
              endif
              assign heading_target = '_self'
              if block.settings.open_new_window
                assign heading_target = '_blank'
              endif
            -%}
            <div
              class="yaomri-mega-panel__column yaomri-mega-panel__column--links"
              style="
                --ym-column-percent: {{ column_width_number }};
                --ym-column-span: {{ column_span }};
                --ym-column-size: {{ block.settings.font_size | default: 13 }}px;
                --ym-column-gap: {{ block.settings.space_between | default: 10 }}px;
              "
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.heading != blank -%}
                {%- if block.settings.heading_link != blank -%}
                  <a
                    class="yaomri-mega-panel__heading-link"
                    href="{{ block.settings.heading_link }}"
                    {% if heading_target == '_blank' %}target="_blank" rel="noopener"{% endif %}
                    data-mega-link
                  >
                    {{ block.settings.heading }}
                  </a>
                {%- else -%}
                  <p class="yaomri-mega-panel__heading">{{ block.settings.heading }}</p>
                {%- endif -%}
              {%- endif -%}
              {%- if child_menu != blank -%}
                <ul class="yaomri-mega-panel__links" role="list">
                  {%- for link in child_menu.links -%}
                    <li class="yaomri-mega-panel__link-item">
                      <a href="{{ link.url }}" data-mega-link>{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- elsif child_parent_id == parent_id and block.type == 'image_tile_child' -%}
            {%- liquid
              assign tile_width_value = block.settings.column_width | default: '25'
              assign tile_width_number = tile_width_value | plus: 0
              if tile_width_number <= 0 or tile_width_number > 100
                assign tile_width_number = 25
              endif
              assign tile_column_span = 3
              case tile_width_number
                when 20
                  assign tile_column_span = 2
                when 25
                  assign tile_column_span = 3
                when 33
                  assign tile_column_span = 4
                when 50
                  assign tile_column_span = 6
                when 66
                  assign tile_column_span = 8
                when 75
                  assign tile_column_span = 9
                when 100
                  assign tile_column_span = 12
              endcase
            -%}
            <article
              class="yaomri-mega-panel__column yaomri-mega-panel__column--tile"
              style="
                --ym-column-percent: {{ tile_width_number }};
                --ym-column-span: {{ tile_column_span }};
              "
              {{ block.shopify_attributes }}
            >
              {%- assign tile_url = block.settings.url | default: '#' -%}
              <a class="yaomri-mega-panel__tile-link" href="{{ tile_url }}" data-mega-link>
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 700
                    | image_tag:
                      class: 'yaomri-mega-panel__tile-image',
                      widths: '180,240,320,420,540,700',
                      sizes: '(min-width: 1024px) 240px, 100vw',
                      loading: 'lazy',
                      alt: block.settings.image_alt | default: block.settings.title
                  }}
                {%- endif -%}
                <span class="yaomri-mega-panel__tile-body">
                  {%- if block.settings.eyebrow != blank -%}
                    <span class="yaomri-mega-panel__tile-eyebrow">{{ block.settings.eyebrow }}</span>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <span class="yaomri-mega-panel__tile-title">{{ block.settings.title }}</span>
                  {%- endif -%}
                  {%- if block.settings.cta != blank -%}
                    <span class="yaomri-mega-panel__tile-cta">{{ block.settings.cta }}</span>
                  {%- endif -%}
                </span>
              </a>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}
