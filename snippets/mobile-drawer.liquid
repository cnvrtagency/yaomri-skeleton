{%- liquid
  assign drawer_menu = menu

  assign drawer_title = section.settings.mobile_menu_label | default: 'Menu'
  assign search_placeholder = section.settings.mobile_drawer_search_placeholder | default: 'Search Ya Omri'
  assign wishlist_target = section.settings.mobile_drawer_wishlist_link | default: wishlist_url | default: '/pages/wishlist'
  assign shipping_label = section.settings.mobile_drawer_shipping_label | default: 'Shipping to'
  assign shipping_region = section.settings.mobile_drawer_shipping_region | default: 'United Arab Emirates · AED'
  assign instagram_label = section.settings.mobile_drawer_instagram_label | default: 'Follow @yaomri'
  assign instagram_url = section.settings.mobile_drawer_instagram_url | default: '#'
-%}

<div
  id="MobileDrawer"
  class="mdrawer"
  data-mdrawer
  aria-hidden="true"
  style="
    --paper: {{ section.settings.mobile_drawer_background }};
    --ink: {{ section.settings.mobile_drawer_text }};
    --mdrawer-max-width: {{ section.settings.mobile_drawer_width }}px;
  "
>
  <button class="mdrawer__scrim" type="button" data-mdrawer-close aria-label="Close menu"></button>

  <aside class="mdrawer__panel" role="dialog" aria-modal="true" aria-labelledby="MobileDrawerTitle" tabindex="-1">
    <header class="mdrawer__header is-root" data-mdrawer-header>
      <button class="mdrawer__icon-btn mdrawer__back" type="button" data-mdrawer-back hidden aria-label="Back">
        {% render 'icon-yaomri-chevron-left' %}
      </button>
      <h2 id="MobileDrawerTitle" class="mdrawer__title" data-mdrawer-title>{{ drawer_title }}</h2>
      <button class="mdrawer__icon-btn mdrawer__close" type="button" data-mdrawer-close aria-label="Close menu">
        {% render 'icon-yaomri-close' %}
      </button>
    </header>

    <div class="mdrawer__body">
      <div class="mdrawer__view is-active" data-mdrawer-view="root">
        {%- if section.settings.show_mobile_drawer_search -%}
          <form class="mdrawer__search" action="{{ routes.search_url }}" method="get" role="search">
            <label class="visually-hidden" for="DrawerSearchInput">Search</label>
            <span class="mdrawer__search-icon" aria-hidden="true">{% render 'icon-yaomri-search' %}</span>
            <input id="DrawerSearchInput" type="search" name="q" placeholder="{{ search_placeholder | escape }}" autocomplete="off">
            <input type="hidden" name="options[prefix]" value="last">
          </form>
        {%- endif -%}

        <nav class="mdrawer__nav" aria-label="Mobile menu">
          <ul class="mdrawer__nav-list" role="list">
            {%- for link in drawer_menu.links -%}
              <li>
                {%- if link.links.size > 0 -%}
                  {%- assign panel_id = 'panel-' | append: link.handle -%}
                  <button
                    class="mdrawer__nav-item"
                    type="button"
                    data-mdrawer-drill
                    data-target="{{ panel_id }}"
                    data-title="{{ link.title | escape }}"
                  >
                    <span>{{ link.title }}</span>
                    <span class="mdrawer__chevron" aria-hidden="true">{% render 'icon-yaomri-chevron-right' %}</span>
                  </button>
                {%- else -%}
                  <a class="mdrawer__nav-item" href="{{ link.url }}">{{ link.title }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>

        {%- if section.settings.show_mobile_drawer_footer -%}
          <div class="mdrawer__footer" data-mdrawer-root-only>
            <div class="mdrawer__utility-links">
              {%- if section.settings.show_mobile_drawer_sign_in and shop.customer_accounts_enabled -%}
                <a href="{{ routes.account_login_url }}">Sign in / Register</a>
              {%- endif -%}
              {%- if section.settings.show_mobile_drawer_wishlist -%}
                <a href="{{ wishlist_target }}">Wishlist</a>
              {%- endif -%}
            </div>

            {%- if section.settings.show_mobile_drawer_shipping -%}
              <p class="mdrawer__shipping">{{ shipping_label }} {{ shipping_region }}</p>
            {%- endif -%}

            {%- if section.settings.show_mobile_drawer_instagram -%}
              <a class="mdrawer__instagram" href="{{ instagram_url }}" target="_blank" rel="noopener">
                {{ instagram_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for link in drawer_menu.links -%}
        {%- if link.links.size > 0 -%}
          {%- assign panel_id = 'panel-' | append: link.handle -%}
          <div class="mdrawer__view" data-mdrawer-view="{{ panel_id }}">
            <nav class="mdrawer__drill-nav" aria-label="{{ link.title | escape }}">
              <ul class="mdrawer__drill-list" role="list">
                {%- assign ungrouped_started = false -%}
                {%- for child in link.links -%}
                  {%- assign parts = child.title | split: '/' -%}
                  {%- assign group_name = '' -%}
                  {%- assign item_label = child.title -%}
                  {%- if parts.size > 1 -%}
                    {%- assign group_name = parts[0] | strip -%}
                    {%- assign item_label = parts[1] | strip -%}
                  {%- endif -%}

                  {%- if group_name != blank -%}
                    {%- ifchanged group_name -%}
                      <li class="mdrawer__group">{{ group_name }}</li>
                    {%- endifchanged -%}
                  {%- elsif ungrouped_started == false -%}
                    <li class="mdrawer__group">Shop</li>
                    {%- assign ungrouped_started = true -%}
                  {%- endif -%}

                  <li>
                    <a class="mdrawer__drill-item" href="{{ child.url }}">
                      {{ item_label }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </aside>
</div>
