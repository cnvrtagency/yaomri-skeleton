{%- liquid
  assign drawer_menu = menu

  assign drawer_title = section.settings.mobile_menu_label
  assign has_drawer_title = false
  if drawer_title != blank
    assign has_drawer_title = true
  endif
  assign search_placeholder = section.settings.mobile_drawer_search_placeholder | default: 'Search CNVRT'
-%}

<div
  id="MobileDrawer"
  class="cnvrt-drawer"
  data-cnvrt-drawer
  aria-hidden="true"
  style="
    --paper: {{ section.settings.mobile_drawer_background }};
    --ink: {{ section.settings.mobile_drawer_text }};
    --cnvrt-drawer-max-width: {{ section.settings.mobile_drawer_width }}px;
  "
>
  <button class="cnvrt-drawer__scrim" type="button" data-cnvrt-drawer-close aria-label="Close menu"></button>

  <aside class="cnvrt-drawer__panel" role="dialog" aria-modal="true"{% if has_drawer_title %} aria-labelledby="MobileDrawerTitle"{% else %} aria-label="Mobile menu"{% endif %} tabindex="-1">
    <header class="cnvrt-drawer__header is-root{% unless has_drawer_title %} cnvrt-drawer__header--no-title{% endunless %}" data-cnvrt-drawer-header>
      <button class="cnvrt-drawer__icon-btn cnvrt-drawer__back" type="button" data-cnvrt-drawer-back hidden aria-label="Back">
        {% render 'icon-cnvrt-chevron-left' %}
      </button>
      {%- if has_drawer_title -%}
        <h2 id="MobileDrawerTitle" class="cnvrt-drawer__title" data-cnvrt-drawer-title>{{ drawer_title }}</h2>
      {%- endif -%}
      <button class="cnvrt-drawer__icon-btn cnvrt-drawer__close" type="button" data-cnvrt-drawer-close aria-label="Close menu">
        {% render 'icon-cnvrt-close' %}
      </button>
    </header>

    <div class="cnvrt-drawer__body">
      <div class="cnvrt-drawer__view is-active" data-cnvrt-drawer-view="root">
        {%- if section.settings.show_mobile_drawer_search -%}
          <form class="cnvrt-drawer__search" action="{{ routes.search_url }}" method="get" role="search">
            <label class="visually-hidden" for="DrawerSearchInput">Search</label>
            <span class="cnvrt-drawer__search-icon" aria-hidden="true">{% render 'icon-cnvrt-search' %}</span>
            <input id="DrawerSearchInput" type="search" name="q" placeholder="{{ search_placeholder | escape }}" autocomplete="off">
            <input type="hidden" name="options[prefix]" value="last">
          </form>
        {%- endif -%}

        <nav class="cnvrt-drawer__nav" aria-label="Mobile menu">
          <ul class="cnvrt-drawer__nav-list" role="list">
            {%- for link in drawer_menu.links -%}
              <li>
                {%- if link.links.size > 0 -%}
                  {%- assign panel_id = 'panel-' | append: link.handle -%}
                  <button
                    class="cnvrt-drawer__nav-item"
                    type="button"
                    data-cnvrt-drawer-drill
                    data-cnvrt-target="{{ panel_id }}"
                    data-cnvrt-controls="drawer-panel-{{ panel_id }}"
                    aria-controls="drawer-panel-{{ panel_id }}"
                    aria-expanded="false"
                    data-cnvrt-title="{{ link.title | escape }}"
                  >
                    <span>{{ link.title }}</span>
                    <span class="cnvrt-drawer__chevron" aria-hidden="true">{% render 'icon-cnvrt-chevron-right' %}</span>
                  </button>
                {%- else -%}
                  <a class="cnvrt-drawer__nav-item" href="{{ link.url }}">{{ link.title }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>

        {%- if section.settings.show_mobile_drawer_footer and section.blocks.size > 0 -%}
          {%- capture drawer_footer_content -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'footer_link' -%}
                  {%- liquid
                    assign footer_link = block.settings.link
                    assign footer_label = block.settings.label
                    assign footer_icon = block.settings.icon | default: 'none'
                    if footer_icon == 'account' and footer_link == blank
                      if shop.customer_accounts_enabled
                        assign footer_link = routes.account_login_url
                      endif
                    elsif footer_icon == 'heart' and footer_link == blank
                      assign footer_link = settings.wishlist_link | default: wishlist_url | default: '/pages/wishlist'
                    endif
                  -%}
                    {%- if footer_label != blank and footer_link != blank -%}
                    <a class="cnvrt-drawer__footer-item" href="{{ footer_link }}" {% if block.settings.open_new_window %}target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>
                      {%- if footer_icon == 'account' and shop.customer_accounts_enabled -%}
                        <span class="cnvrt-drawer__footer-icon" aria-hidden="true">{% render 'icon-cnvrt-account' %}</span>
                      {%- elsif footer_icon == 'heart' -%}
                        <span class="cnvrt-drawer__footer-icon" aria-hidden="true">{% render 'icon-cnvrt-heart' %}</span>
                      {%- endif -%}
                      <span>{{ footer_label }}</span>
                    </a>
                  {%- endif -%}
                {%- when 'country_selector' -%}
                  {%- if localization.available_countries.size > 1 -%}
                    {%- form 'localization', id: 'MobileDrawerCountryForm', class: 'cnvrt-drawer__country-form' -%}
                      {%- if block.settings.label != blank -%}
                        <label class="cnvrt-drawer__country-label" for="MobileDrawerCountrySelector">{{ block.settings.label }}</label>
                      {%- else -%}
                        <label class="visually-hidden" for="MobileDrawerCountrySelector">Country/region</label>
                      {%- endif -%}
                      <select
                        id="MobileDrawerCountrySelector"
                        class="cnvrt-drawer__country-select"
                        name="country_code"
                        aria-label="Country/region"
                        onchange="this.form.submit()"
                      >
                        {%- for country in localization.available_countries -%}
                          <option
                            value="{{ country.iso_code }}"
                            {%- if country.iso_code == localization.country.iso_code -%} selected{%- endif -%}
                          >
                            {{ country.name }} ({{ country.currency.iso_code }}{% if country.currency.symbol != blank %} {{ country.currency.symbol }}{% endif %})
                          </option>
                        {%- endfor -%}
                      </select>
                    {%- endform -%}
                  {%- endif -%}
                {%- when 'text_row' -%}
                  {%- if block.settings.label != blank or block.settings.text != blank -%}
                    <p class="cnvrt-drawer__footer-text" {{ block.shopify_attributes }}>
                      {%- if block.settings.label != blank -%}<span>{{ block.settings.label }}</span>{%- endif -%}
                      {%- if block.settings.text != blank -%}<strong>{{ block.settings.text }}</strong>{%- endif -%}
                    </p>
                  {%- endif -%}
                {%- when 'social_link' -%}
                  {%- if block.settings.label != blank and block.settings.link != blank -%}
                    <a class="cnvrt-drawer__footer-item--social" href="{{ block.settings.link }}" {% if block.settings.open_new_window %}target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>
                      <span>{{ block.settings.label }}</span>
                    </a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
              {%- endcapture -%}
          {%- assign drawer_footer_content = drawer_footer_content | strip -%}
            {%- if drawer_footer_content != blank -%}
            <div class="cnvrt-drawer__footer">
              {{ drawer_footer_content }}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- for link in drawer_menu.links -%}
        {%- if link.links.size > 0 -%}
          {%- assign panel_id = 'panel-' | append: link.handle -%}
          <div class="cnvrt-drawer__view" data-cnvrt-drawer-view="{{ panel_id }}" id="drawer-panel-{{ panel_id }}">
            <nav class="cnvrt-drawer__drill-nav" aria-label="{{ link.title | escape }}">
              <ul class="cnvrt-drawer__drill-list" role="list">
                {%- assign ungrouped_started = false -%}
                {%- for child in link.links -%}
                  {%- assign parts = child.title | split: '/' -%}
                  {%- assign group_name = '' -%}
                  {%- assign item_label = child.title -%}
                  {%- if parts.size > 1 -%}
                    {%- assign group_name = parts[0] | strip -%}
                    {%- assign item_label = parts[1] | strip -%}
                  {%- endif -%}

                  {%- if group_name != blank -%}
                    {%- ifchanged group_name -%}
                      <li class="cnvrt-drawer__group">{{ group_name }}</li>
                    {%- endifchanged -%}
                  {%- elsif ungrouped_started == false -%}
                    <li class="cnvrt-drawer__group">Shop</li>
                    {%- assign ungrouped_started = true -%}
                  {%- endif -%}

                  <li>
                    <a class="cnvrt-drawer__drill-item" href="{{ child.url }}">
                      {{ item_label }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </aside>
</div>
