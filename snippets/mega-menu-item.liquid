{%- liquid
  assign item_title = block.settings.title | default: block.settings.heading
  assign item_url = block.settings.link | default: '#'
  assign item_target = '_self'
  if block.settings.open_new_window
    assign item_target = '_blank'
  endif

  assign is_highlighted = false
  assign item_style = ''
  if block.settings.highlight_item and block.settings.highlight_color != blank
    assign is_highlighted = true
    assign item_style = '--cnvrt-mega-link-color:' | append: block.settings.highlight_color | append: ';'
  endif

  assign item_label = block.settings.label_text
-%}

{%- if block.type == 'base_item' -%}
  <li
    class="cnvrt-mega__item cnvrt-mega__item--link{% if is_highlighted %} is-highlighted{% endif %}"
    style="{{ item_style }}"
    {{ block.shopify_attributes }}
  >
    <a
      class="cnvrt-header__nav-link cnvrt-mega__top-link{% if is_highlighted %} cnvrt-mega__top-link--highlight{% endif %}"
      href="{{ item_url }}"
      {% if item_target == '_blank' %}target="_blank" rel="noopener"{% endif %}
      data-mega-link
    >
      <span>{{ item_title }}</span>
      {%- if item_label != blank -%}
        <span
          class="cnvrt-mega__label"
          style="--cnvrt-mega-label-color: {{ block.settings.label_color }};"
        >
          {{ item_label }}
        </span>
      {%- endif -%}
    </a>
  </li>
{%- elsif block.type == 'dropdown_item' -%}
  {%- liquid
    assign dropdown_width = block.settings.dropdown_width | default: 260
    assign dropdown_style = item_style | append: '--cnvrt-mega-dropdown-width:' | append: dropdown_width | append: 'px;'
    assign dropdown_menu = blank
    assign dropdown_panel_id = 'cnvrt-mega-dropdown-' | append: block.id
    if block.settings.menu != blank
      assign dropdown_menu = linklists[block.settings.menu]
      if dropdown_menu != blank and dropdown_menu.links.size == 0
        assign dropdown_menu = blank
      endif
    endif
  -%}
  <li
    class="cnvrt-mega__item cnvrt-mega__item--dropdown cnvrt-mega__item--{{ block.settings.dropdown_position | default: 'start' }}{% if is_highlighted %} is-highlighted{% endif %}"
    style="{{ dropdown_style }}"
    data-dropdown
    {{ block.shopify_attributes }}
  >
    <a
      class="cnvrt-header__nav-link cnvrt-mega__top-link{% if is_highlighted %} cnvrt-mega__top-link--highlight{% endif %}"
      href="{{ item_url }}"
      {% if item_target == '_blank' %}target="_blank" rel="noopener"{% endif %}
      data-dropdown-trigger
      data-dropdown-target="{{ dropdown_panel_id }}"
      data-mega-link
      aria-controls="{{ dropdown_panel_id }}"
      aria-expanded="false"
      aria-haspopup="true"
    >
      <span>{{ item_title }}</span>
      {%- if item_label != blank -%}
        <span
          class="cnvrt-mega__label"
          style="--cnvrt-mega-label-color: {{ block.settings.label_color }};"
        >
          {{ item_label }}
        </span>
      {%- endif -%}
    </a>
    {%- if dropdown_menu != blank -%}
      <div
        class="cnvrt-mega__dropdown-panel"
        data-dropdown-panel
        id="{{ dropdown_panel_id }}"
      >
        <ul class="cnvrt-mega__dropdown-list" role="list">
          {%- for child in dropdown_menu.links -%}
            <li class="cnvrt-mega__dropdown-item">
              <a href="{{ child.url }}" data-mega-link>{{ child.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </li>
{%- elsif block.type == 'mega_item' -%}
  {%- liquid
    assign mega_id = block.settings.mega_menu_id | strip
    assign mega_panel_id = 'cnvrt-mega-panel-' | append: mega_id
  -%}
  <li
    class="cnvrt-mega__item cnvrt-mega__item--mega{% if is_highlighted %} is-highlighted{% endif %}"
    style="{{ item_style }}"
    data-mega-item
    {{ block.shopify_attributes }}
  >
    <a
      class="cnvrt-header__nav-link cnvrt-mega__top-link{% if is_highlighted %} cnvrt-mega__top-link--highlight{% endif %}"
      href="{{ item_url }}"
      {% if item_target == '_blank' %}target="_blank" rel="noopener"{% endif %}
      data-mega-trigger
      aria-controls="{{ mega_panel_id }}"
      data-mega-target="{{ mega_id | escape }}"
      aria-expanded="false"
      aria-haspopup="true"
      data-mega-link
    >
      <span>{{ item_title }}</span>
      {%- if item_label != blank -%}
        <span
          class="cnvrt-mega__label"
          style="--cnvrt-mega-label-color: {{ block.settings.label_color }};"
        >
          {{ item_label }}
        </span>
      {%- endif -%}
    </a>
  </li>
{%- endif -%}
